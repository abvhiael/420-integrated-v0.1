{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "420-integrated-analytics",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/health", "/ready"],
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "analytics.420integrated.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
