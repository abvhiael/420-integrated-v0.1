{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "420bet",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-07",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/420bet/sportsbook/*"
    ]
  }
}
