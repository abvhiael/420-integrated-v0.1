    "publicFaultDetailPolicy": "categorical only; raw upstream errors remain server-side",
    "recoveryRule": "clear degraded runtime latch only after qualified RPC source, qualified consensus provider, and successful catch-up",
    "liveFaultInjectionStatus": "BLOCKED_PENDING_PROVISIONED_TESTNET"
