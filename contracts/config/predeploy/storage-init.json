  "entries": {
    "RewardController": {"constructor":["governance_timelock"],"post_init":["bindConsensusSystemCaller(consensus_system_call)"]},
    "AttentionTreasury": {"constructor":["governance_timelock"]},
    "DevelopmentTreasury": {"constructor":["governance_timelock"]},
    "ValidatorRegistry": {"constructor":["governance_timelock"],"post_init":["bindConsensusSystemCaller(consensus_system_call)","bindCommunityValidatorReserve(community_validator_reserve)"]},
    "ProtocolReserve": {"constructor":["governance_timelock"]},
    "CommunityValidatorReserve": {"constructor":["governance_timelock"],"post_init":["bindValidatorRegistry(ValidatorRegistry@0x0423)"]},
    "CommunityRewardReserve": {"constructor":["governance_timelock"]},
    "FounderVestingRegistry": {"constructor":["governance_timelock","founder_beneficiaries[10]","genesis_time"]},
    "RandomnessRegistry": {"constructor":["governance_timelock"]},
    "GovernanceTimelock": {"constructor":["bootstrap_governor"]},
    "PublicDistributionVault": {"constructor":["governance_timelock","genesis_time"]},
    "GenesisDEXFactory": {"constructor":["governance_timelock","dex_pool_implementation"]},
    "PublicBatchAuction": {"constructor":["governance_timelock"]},
    "TWAPOracle": {"constructor":["governance_timelock"]},
    "ValidatorBootstrapReserve": {"constructor":["governance_timelock"]},
    "AIProviderRegistry": {"constructor":["governance_timelock"]},
    "AIModelRegistry": {"constructor":["governance_timelock"]},
    "AIJobManager": {"constructor":["governance_timelock"]},
    "AIJobEscrow": {"constructor":["governance_timelock"]},
    "AIReputationRegistry": {"constructor":["governance_timelock"]},
    "ProtocolRegistry": {"constructor":["governance_timelock"]},
    "Names420": {"constructor":["governance_timelock"]},
    "Identity420": {"constructor":["governance_timelock"]},
    "Governance420": {"constructor":["governance_timelock"]},
