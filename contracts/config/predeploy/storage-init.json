{
  "schema": "420-predeploy-storage-init-v2",
  "governance_timelock": "0x0000000000000000000000000000000000000429",
  "consensus_system_call": "0x000000000000000000000000000000000000043c",
  "community_validator_reserve": "0x0000000000000000000000000000000000000425",
  "genesis_time": "FROM_FROZEN_TESTNET_OR_MAINNET_GENESIS",
  "founder_beneficiaries": "UNRESOLVED_DO_NOT_INVENT",
  "bridge_verifier": "FROM_FROZEN_GATEWAY_VERIFICATION_DECISION",
