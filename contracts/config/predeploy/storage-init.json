    "CannaseurCampaignRegistry": {"constructor":["governance_timelock"]},
    "ConsensusSystemCall420": {"constructor":["governance_timelock"]}
  },
  "rules": [
    "Direct predeploy placement does not execute Solidity constructors; constructor and post_init effects must be materialized in genesis storage deterministically.",
    "RewardController and ValidatorRegistry MUST begin with consensusSystemCaller=0x043c and consensusSystemCallerBound=true.",
    "ValidatorRegistry and CommunityValidatorReserve MUST begin mutually bound at 0x0423/0x0425.",
    "ConsensusSystemCall420 itself has no mutable caller binding; it accepts top-level calls only from go-ethereum params.SystemAddress."
  ]
}
