/// @notice RFC9380 XMD/SHA256 hash-to-G2 with checked square-root witnesses.
/// Witnesses supply only square roots. Candidate selection, signs, isogeny and
/// cofactor multiplication are independently calculated on chain.
contract BnbBlsHash420 {
 error InvalidHashWitness();
 function hashField(bytes32 msg_) public view returns(M.F2[2] memory t){
  bytes memory dst=abi.encodePacked("BLS_SIG_BLS12381G2_XMD:SHA-256_SSWU_RO_POP_",bytes1(0x2b));
  bytes32 b0=sha256(abi.encodePacked(new bytes(64),msg_,hex"010000",dst));bytes32 previous=sha256(abi.encodePacked(b0,hex"01",dst));bytes memory uniform=abi.encodePacked(previous);
  for(uint8 i=2;i<=8;++i){previous=sha256(abi.encodePacked(b0^previous,bytes1(i),dst));uniform=abi.encodePacked(uniform,previous);}
  M.F[4] memory values;
  for(uint256 i;i<4;++i){uint256 hi;uint256 lo;uint256 at=64*i;assembly("memory-safe"){hi:=mload(add(add(uniform,32),at)) lo:=mload(add(add(uniform,64),at))}values[i]=M.modexp(M.F(hi,lo),M.c(1));}
  t[0]=M.F2(values[0],values[1]);t[1]=M.F2(values[2],values[3]);
 }
