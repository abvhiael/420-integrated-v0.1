contract AIV1Modules420Test{
VmAIV1Modules420 constant vm=VmAIV1Modules420(address(uint160(uint256(keccak256("hevm cheat code")))));address constant ALICE=address(0xA11CE);bytes32 constant PROVIDER=keccak256("provider");bytes32 constant MODEL=keccak256("model");bytes32 constant VERSION=keccak256("version");bytes32 constant DEPLOYMENT=keccak256("deployment");bytes32 constant JOB=keccak256("job");
