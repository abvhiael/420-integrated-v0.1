AIRequestRegistry420 rq=new AIRequestRegistry420(address(j));AIResultRegistry420 rr=new AIResultRegistry420(address(j));vm.prank(ALICE);j.createRequest(JOB,VERSION,AIIds420.WORKLOAD_TEXT,keccak256("in"),keccak256("privacy"),keccak256("v"),55,uint64(block.timestamp+1 days));require(rq.getRequest(JOB).requester==ALICE);require(rr.getResult(JOB).outputCommitment==0);vm.prank(j.AI_JOB_ESCROW());j.confirmFunding(JOB,keccak256("fund"),55);MockComputeAIV1 comp=new MockComputeAIV1();AIComputeAdapter420 ad=new AIComputeAdapter420(address(j),address(a),address(comp),address(pr),address(m),address(d));require(address(ad.computeJobs())!=address(0));require(ad.computeRouter()==ICompute420(address(comp)));
AIPolicyRegistry420 pol=new AIPolicyRegistry420(address(this));AIRouter420 router=new AIRouter420(address(pr),address(m),address(j),address(a),address(pol),address(d),address(rq),address(rr),address(ad));require(router.componentGraphHash()!=0);require(router.jobManager()==address(j));}
