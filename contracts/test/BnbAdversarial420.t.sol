pragma solidity ^0.8.24;
import "./BnbConsensus420.t.sol";
contract BnbAdversarial420Test is BnbConsensus420Test {
 function reject(address target,bytes memory data) internal {(bool ok,)=target.call(data);require(!ok,"adversarial proof accepted");}
 function alter(bytes memory raw,uint256 which,bytes memory encoded) internal pure returns(bytes memory){EthereumRLP420.Item[] memory f=EthereumRLP420.children(raw,EthereumRLP420.item(raw,0));bytes[] memory out=new bytes[](f.length);for(uint256 i;i<f.length;++i)out[i]=i==which?encoded:EthereumRLP420.encoded(raw,f[i]);return BnbHeader420.list(out);}
 function testBadBootstrapCannotSubstituteCommitteeOrCheckpoint() public {BnbBlsVerifier420 v=new BnbBlsVerifier420();bytes memory c=header(116663998);bytes memory p=header(116662000);bytes memory e=header(116663000);bool reverted;try new BnbConsensusLightClient420(address(v),bytes32(uint256(1)),c,p,e) returns(BnbConsensusLightClient420){ }catch{reverted=true;}require(reverted);}
 function testQuorumOutOfRangeBitsAndMalformedVoteRejected() public {BnbConsensusLightClient420 c=client(new BnbBlsVerifier420());bytes memory vote=file("vote_116664000.rlp");reject(address(c),abi.encodeCall(c.certificate,(alter(vote,0,BnbHeader420.enc(hex"01")))));reject(address(c),abi.encodeCall(c.certificate,(alter(vote,0,BnbHeader420.enc(hex"80000000")))));reject(address(c),abi.encodeCall(c.certificate,(abi.encodePacked(vote,hex"00"))));reject(address(c),abi.encodeCall(c.certificate,(alter(vote,1,BnbHeader420.enc(new bytes(95))))));}
 function testUnfinalizedEpochCannotAuthorizeItsNewKeys() public {BnbConsensusLightClient420 c=client(new BnbBlsVerifier420());reject(address(c),abi.encodeCall(c.certificate,(file("vote_116664090.rlp"))));require(c.epochCount()==2);}
 function testUncomputedBlsCannotFinalizeOrRegisterEpoch() public {BnbConsensusLightClient420 c=client(new BnbBlsVerifier420());bytes[] memory a=new bytes[](1);a[0]=header(116663999);reject(address(c),abi.encodeCall(c.finalize,(header(116664000),header(116664001),a,file("vote_116664000.rlp"),file("vote_116664001.rlp"))));require(c.finalizedNumber()==116663998 && c.epochCount()==2);}
 function testHeaderCanonicalFieldsAndNetworkSealFailClosed() public {bytes memory raw=header(116664001);this.parse(raw);bool reverted;try this.parse(abi.encodePacked(raw,hex"00")) {}catch{reverted=true;}require(reverted);reverted=false;try this.parse(alter(raw,14,BnbHeader420.enc(hex"0000000000000001"))){}catch{reverted=true;}require(reverted);reverted=false;try this.parse(alter(raw,2,BnbHeader420.enc(abi.encodePacked(address(0xBAD))))){}catch{reverted=true;}require(reverted);}
 function parse(bytes memory raw) external pure {BnbHeader420.Header memory h=BnbHeader420.parse(raw);BnbHeader420.signer(h);}
 function testBlsMalformedCompressionAndWitnessCannotStartJob() public {BnbBlsVerifier420 v=new BnbBlsVerifier420();(bytes[] memory keys,bytes32 m,bytes memory sig,BnbBlsVerifier420.Witness memory w)=abi.decode(file("bls-vector.bin"),(bytes[],bytes32,bytes,BnbBlsVerifier420.Witness));keys[0][0]|=0x40;reject(address(v),abi.encodeCall(v.begin,(keys,m,sig,w)));keys[0][0]&=0xbf;w.signatureY.c0.l^=1;reject(address(v),abi.encodeCall(v.begin,(keys,m,sig,w)));}
 function testParsingCacheGrantsNoFinalityOrCommitteeAuthority() public {BnbConsensusLightClient420 c=client(new BnbBlsVerifier420());c.cacheHeader(header(116664000));c.cacheHeader(header(116664090));reject(address(c),abi.encodeCall(c.certificate,(file("vote_116664090.rlp"))));require(c.epochCount()==2 && c.finalizedNumber()==116663998);BnbHeader420.Header memory h=BnbHeader420.parse(header(116664090));require(!c.isFinalizedExecutionBlock(h.number,h.hash,h.receiptsRoot));}
 function testFuzzFieldMultiplicationMatchesNativeUint256(uint128 a,uint128 b) public view {M.F memory r=M.m(M.c(a),M.c(b));require(r.h==0 && r.l==uint256(a)*uint256(b));}
}
