pragma solidity ^0.8.24;
import "../src/bridge/verifiers/bnb/BnbConsensusLightClient420.sol";
interface BnbConsensusVm420 {function readFileBinary(string calldata) external view returns(bytes memory);function toString(uint256) external pure returns(string memory);}
contract BnbConsensus420Test {
 BnbConsensusVm420 constant vm=BnbConsensusVm420(address(uint160(uint256(keccak256("hevm cheat code")))));
 function file(string memory s) internal view returns(bytes memory){return vm.readFileBinary(string.concat("contracts/test/fixtures/bnb/",s));}
 function header(uint256 n) internal view returns(bytes memory){return file(string.concat("header_",vm.toString(n),".rlp"));}
 function client(BnbBlsVerifier420 v) internal returns(BnbConsensusLightClient420){bytes memory c=header(116663998);bytes memory p=header(116662000);bytes memory e=header(116663000);return new BnbConsensusLightClient420(address(v),keccak256(abi.encode(uint256(56),keccak256(c),keccak256(p),keccak256(e))),c,p,e);}
 function testHistoricalHeadersAndAuthenticatedBootstrap() public {BnbBlsVerifier420 v=new BnbBlsVerifier420();BnbConsensusLightClient420 c=client(v);require(c.finalizedNumber()==116663998);require(c.epochCount()==2);BnbConsensusLightClient420.Epoch memory e=c.committee(1);require(e.active==116663087 && e.keys.length==21);BnbHeader420.Header memory h=BnbHeader420.parse(header(116664001));require(h.hash==0x67abcdf912b35d5abf88941b5f8206cc6b497bbdc079bdb727a8f8b70f5f8d7f);require(BnbHeader420.signer(h)==h.miner);}
 error ProgressGas(uint256 spent,uint8 phase);
 function finish(BnbBlsVerifier420 v,uint256 n) internal { (bytes[] memory pk,bytes32 m,bytes memory sig,BnbBlsVerifier420.Witness memory w)=abi.decode(file(string.concat("vote_",vm.toString(n),".bin")),(bytes[],bytes32,bytes,BnbBlsVerifier420.Witness));bytes32 id=v.begin(pk,m,sig,w);uint256 steps;uint256 maxGas;(bool done,,,)=v.status(id);while(!done){uint256 g=gasleft();v.advance(id);uint256 spent=g-gasleft();if(spent>30000000){(,,uint8 phase,)=v.status(id);revert ProgressGas(spent,phase);}if(spent>maxGas)maxGas=spent;require(++steps<22000);(done,,,)=v.status(id);}require(v.result(id),"historical BLS invalid");require(maxGas<30000000,"one progress call exceeds block gas");}
 function testHistoricalFinalityAndRealValidatorTransition() public {BnbBlsVerifier420 v=new BnbBlsVerifier420();BnbConsensusLightClient420 c=client(v);finish(v,116664000);finish(v,116664001);bytes[] memory a=new bytes[](1);a[0]=header(116663999);c.finalize(header(116664000),header(116664001),a,file("vote_116664000.rlp"),file("vote_116664001.rlp"));require(c.finalizedNumber()==116664000 && c.epochCount()==3);BnbConsensusLightClient420.Epoch memory e=c.committee(2);require(e.active==116664087);finish(v,116664090);finish(v,116664091);a=new bytes[](89);for(uint256 i;i<89;++i){a[i]=header(116664089-i);c.cacheHeader(a[i]);}c.finalize(header(116664090),header(116664091),a,file("vote_116664090.rlp"),file("vote_116664091.rlp"));require(c.finalizedNumber()==116664090);}
}
