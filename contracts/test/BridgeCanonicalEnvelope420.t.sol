pragma solidity ^0.8.24;
import "./BridgeGenesisIntegration420.t.sol";
contract BridgeCanonicalEnvelope420Test is BridgeGenesisFixture420 {
 function envelope(Fixture memory f) internal view returns(BridgeProofEnvelope420.Envelope memory){return abi.decode(ProofEnvelopeFixture420.mock(f.router,ADAPTER_ID,hex"01"),(BridgeProofEnvelope420.Envelope));}
 function reject(Fixture memory f,BridgeProofEnvelope420.Envelope memory e) internal {(bool ok,)=address(f.router).call(abi.encodeCall(f.router.acceptInbound,(ADAPTER_ID,abi.encode(e))));require(!ok,"invalid envelope accepted");(,,,,,,uint256 tvl)=f.risk.routeUsage(ROUTE_ID);require(tvl==0,"failed envelope consumed risk");}
 function testCanonicalEnvelopeAndAuthenticatedContextAdmit() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));f.router.acceptInbound(ADAPTER_ID,abi.encode(envelope(f)));}
 function testRawNativeProofCannotBypassEnvelope() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));(bool ok,)=address(f.router).call(abi.encodeCall(f.router.acceptInbound,(ADAPTER_ID,hex"01")));require(!ok);}
 function testUnprovenGatewayCannotBeAssertedByCaller() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.sourceGateway=keccak256("forged");reject(f,e);}
 function testCrossRouteAndAssetSubstitutionRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.routeId=keccak256("route");reject(f,e);e=envelope(f);e.assetId=keccak256("asset");reject(f,e);e=envelope(f);e.sourceAsset=keccak256("counterfeit token");reject(f,e);}
 function testWrongChainAndNetworkRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.sourceChainId=2;reject(f,e);e=envelope(f);e.destinationChainId=2;reject(f,e);e=envelope(f);e.sourceNetworkId=keccak256("fork");reject(f,e);e=envelope(f);e.destinationNetworkId=keccak256("wrong genesis");reject(f,e);}
 function testWrongDestinationRouterAndEvmRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.destinationRouter=address(0xBAD);reject(f,e);e=envelope(f);e.destinationChainIdEvm=block.chainid+1;reject(f,e);}
 function testWrongRecipientAndAmountRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.recipient=address(0xBAD);reject(f,e);e=envelope(f);e.amount=8;reject(f,e);}
 function testWrongTransactionAndMessageRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.sourceTxId=keccak256("tx");reject(f,e);e=envelope(f);e.sourceMessageId=keccak256("message");reject(f,e);}
 function testStaleOrFutureObservationRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.expiresAt=uint64(block.timestamp);reject(f,e);e=envelope(f);e.observedAt=uint64(block.timestamp+1);reject(f,e);}
 function testConfigurationAndVersionSubstitutionRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.verifierConfigHash=keccak256("config");reject(f,e);e=envelope(f);e.version=2;reject(f,e);}
 function testTrailingSerializationRejected() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));(bool ok,)=address(f.router).call(abi.encodeCall(f.router.acceptInbound,(ADAPTER_ID,bytes.concat(abi.encode(envelope(f)),hex"00"))));require(!ok);}
 function testRefreshingTransportCannotResetSourceReplay() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));f.router.acceptInbound(ADAPTER_ID,abi.encode(envelope(f)));vm.warp(block.timestamp+60);(bool ok,)=address(f.router).call(abi.encodeCall(f.router.acceptInbound,(ADAPTER_ID,abi.encode(envelope(f)))));require(!ok);(,,,,,,uint256 tvl)=f.risk.routeUsage(ROUTE_ID);require(tvl==7);}
 function testFuzzCallerCannotChangeAuthenticatedGateway(bytes32 gateway) public {if(gateway==0||gateway==keccak256("fixture/gateway"))return;Fixture memory f=_setup();f.adapter.setInbound(_inbound(7));BridgeProofEnvelope420.Envelope memory e=envelope(f);e.sourceGateway=gateway;reject(f,e);}
}
