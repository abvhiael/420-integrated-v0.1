pragma solidity ^0.8.24;
import "./BridgeFullLocalFixture420.sol";
contract BridgeFullLocalIntegration420Test is BridgeFullLocalFixture420 {
    function accept() internal returns(bytes32){return gateway.acceptInboundAndSettle(adapter.ADAPTER_ID(),transport(proof("base-standard")));}
    function reject(bytes memory p) internal {(bool ok,)=address(gateway).call(abi.encodeCall(gateway.acceptInboundAndSettle,(adapter.ADAPTER_ID(),transport(p))));require(!ok,"bad evidence settled");assertClean();}
    function revoke() internal {qualification.revoke(qualification.currentApproval(address(adapter)),keccak256("integration revocation"));}
    function testGenuineIssuerEvidenceCompletesFullLocalLifecycle() public {CCTPV2Message420.Message memory m=message("base-standard");bytes32 id=accept();(bytes32 r,bytes32 asset,,address recipient,uint256 amount,bytes32 txid,bytes32 msgid,BridgeTransferRegistry.Status status,,)=transfers.transfers(id);require(r==route(6)&&asset==ASSET&&recipient==m.mintRecipient&&amount==m.amount-m.fee&&status==BridgeTransferRegistry.Status.COMPLETED);require(txid==keccak256(file("base-standard.message.hex"))&&msgid==sourceMessage());require(token.balanceOf(recipient)==amount&&CCTPNativeMT420(MT).usedNonces(m.nonce)==1&&adapter.consumedNonces(m.nonce));(,,,,,,uint256 tvl)=risk.routeUsage(r);(,,,,,,uint256 assetTvl)=risk.assetUsage(ASSET);require(tvl==amount&&assetTvl==amount,"accounting mismatch");(address settledToken,address delivered,uint256 value,bytes32 evidence)=adapter.settlementEvidence(msgid);require(settledToken==address(token)&&delivered==recipient&&value==amount&&evidence!=0&&transfers.lastEvidenceHash(id)==evidence);
        vm.warp(block.timestamp+1);accounting.applyReconciliation(ASSET,m.amount,token.balanceOf(recipient)+token.balanceOf(FEES),uint64(block.timestamp),evidence);require(accounting.movementHealthy(ASSET),"native authorized/observed supply");}
    function testDelayedCompletionDoesNotMintOrChargeRiskAgain() public {bytes32 id=gateway.acceptInbound(adapter.ADAPTER_ID(),transport(proof("base-standard")));uint256 amount=token.balanceOf(message("base-standard").mintRecipient);gateway.completeInboundSettlement(id);require(token.balanceOf(message("base-standard").mintRecipient)==amount);(,,,,,,uint256 tvl)=risk.routeUsage(route(6));require(tvl==amount);(bool ok,)=address(gateway).call(abi.encodeCall(gateway.completeInboundSettlement,(id)));require(!ok,"duplicate completion");}
    function testOperatorCannotFabricateSettlementCompletion() public {bytes32 id=gateway.acceptInbound(adapter.ADAPTER_ID(),transport(proof("base-standard")));transfers.markDestinationPending(id,keccak256("operator notification"));(bool ok,)=address(transfers).call(abi.encodeCall(transfers.markCompleted,(id,keccak256("arbitrary assertion"))));require(!ok);gateway.completeInboundSettlement(id);}
    function testReplayDoesNotCreditOrConsumeRiskTwice() public {accept();uint256 before=token.balanceOf(message("base-standard").mintRecipient);(bool ok,)=address(gateway).call(abi.encodeCall(gateway.acceptInboundAndSettle,(adapter.ADAPTER_ID(),transport(proof("base-standard")))));require(!ok&&token.balanceOf(message("base-standard").mintRecipient)==before);(,,,,,,uint256 tvl)=risk.routeUsage(route(6));require(tvl==before);}
    function testWrongDestinationDomainRejectedAtomically() public {bytes memory raw=file("base-standard.message.hex");setWord(raw,8,6,4);reject(abi.encode(raw,file("base-standard.attestation.hex")));}
    function testCounterfeitAmountRejectedByActualIssuerSignatures() public {bytes memory raw=file("base-standard.message.hex");setWord(raw,216,message("base-standard").amount+1,32);reject(abi.encode(raw,file("base-standard.attestation.hex")));}
    function testRecipientSubstitutionRejected() public {bytes memory raw=file("base-standard.message.hex");setWord(raw,184,uint160(address(0xBAD)),32);reject(abi.encode(raw,file("base-standard.attestation.hex")));}
    function testAttestationTamperingRejected() public {bytes memory att=file("base-standard.attestation.hex");att[0]=bytes1(uint8(att[0])^1);reject(abi.encode(file("base-standard.message.hex"),att));}
    function testCrossDomainEvidenceCannotUseQualifiedBaseRoute() public {reject(proof("arbitrum-fast"));}
    function testNonCanonicalEnvelopeRejected() public {reject(bytes.concat(proof("base-standard"),hex"00"));}
    function testRiskFailureRollsBackNativeMintAllReplayAndReceipt() public {risk.setRouteLimits(route(6),limits(1));reject(proof("base-standard"));(,,,bytes32 e)=adapter.settlementEvidence(sourceMessage());require(e==0);risk.setRouteLimits(route(6),limits(1_000_000_000 ether));accept();}
    function testLateTransferRegistryFailureRollsBackNativeMint() public {transfers.setRouter(address(gateway),false);reject(proof("base-standard"));transfers.setRouter(address(gateway),true);accept();}
    function testTokenMintFailureRollsBackEntireLifecycle() public {token.setMintMode(1);reject(proof("base-standard"));token.setMintMode(0);accept();}
    function testLyingTokenCannotProduceSettlementReceipt() public {token.setMintMode(2);reject(proof("base-standard"));}
    function testSuspendedRouteRollsBackNativeExecution() public {BridgeRouteRegistry.Route memory next;(next.assetId,next.sourceChainId,next.destinationChainId,next.sourceAsset,next.destinationAsset,next.adapterId,next.verifierConfigHash,next.version,next.status,next.inboundEnabled,next.outboundEnabled)=routes.routes(route(6));next.status=BridgeRouteRegistry.Status.SUSPENDED;routes.setRoute(route(6),next);reject(proof("base-standard"));}
    function testRevocationRejectsHistoricalProofBeforeDelivery() public {revoke();reject(proof("base-standard"));}
    function testRevocationStopsDelayedCompletion() public {bytes32 id=gateway.acceptInbound(adapter.ADAPTER_ID(),transport(proof("base-standard")));revoke();(bool ok,)=address(gateway).call(abi.encodeCall(gateway.completeInboundSettlement,(id)));require(!ok);(,,,,,,,BridgeTransferRegistry.Status status,,)=transfers.transfers(id);require(status==BridgeTransferRegistry.Status.VERIFIED);}
    function testAttesterThresholdDriftInvalidatesQualification() public {CCTPNativeMT420(MT).setSignatureThreshold(1);reject(proof("base-standard"));}
    function testNativeProxyImplementationSubstitutionRejected() public {address implementation=ICircleCCTPProxy420(MT).implementation();bytes memory original=implementation.code;vm.etch(implementation,hex"00");(bool ok,)=address(gateway).call(abi.encodeCall(gateway.acceptInboundAndSettle,(adapter.ADAPTER_ID(),transport(proof("base-standard")))));require(!ok,"substituted native implementation executed");vm.etch(implementation,original);assertClean();}
    function testNativeIssuerPauseRejectsWithoutPartialDelivery() public {CCTPNativeMT420(MT).pause();reject(proof("base-standard"));}
    function testNativeTokenPairSubstitutionRejected() public {minter.unlinkTokenPair(address(token),6,message("base-standard").burnToken);reject(proof("base-standard"));}
    function testAccountingHealthFailureRollsBackNativeMint() public {vm.warp(block.timestamp+1);accounting.applyReconciliation(ASSET,2,1,uint64(block.timestamp),keccak256("bad supply"));reject(proof("base-standard"));}
    function testOutboundNativeBurnCannotBeReportedCompletedWithoutReceipt() public {installNativeCustody();accept();token.fund(address(this),10e6);token.approve(address(adapter),10e6);bytes32 msgid=gateway.initiateOutbound(adapter.ADAPTER_ID(),route(6),ASSET,abi.encode(bytes32(uint256(uint160(address(0xB0B))))),10e6,abi.encode(bytes32(0),uint256(0),uint32(2000),bytes("")));require(token.balanceOf(address(this))==0);bytes32 id=transfers.deriveOutboundTransferId(route(6),ASSET,address(this),keccak256(abi.encode(bytes32(uint256(uint160(address(0xB0B)))))),10e6,msgid);(bool ok,)=address(gateway).call(abi.encodeCall(gateway.completeInboundSettlement,(id)));require(!ok);}
    function testLateSettlementAssetMismatchRollsBackVerificationAndMint() public {env.setSettlementAsset(address(0xABCD),ASSET,true);reject(proof("base-standard"));(,,,bytes32 receipt)=adapter.settlementEvidence(sourceMessage());require(receipt==0);}
    function testUnconfiguredNativeIssuerRemainsInactive() public {USDCCCTPAdapter fresh=new USDCCCTPAdapter(address(this),address(gateway),address(token),ASSET);vm.prank(address(gateway));(bool ok,bytes memory reason)=address(fresh).call(abi.encodeCall(fresh.verifyInbound,(proof("base-standard"))));require(!ok&&bytes4(reason)==USDCCCTPAdapter.Inactive.selector);}
    function testFuzzHistoricalAttestationCannotAuthenticateChangedAmount(uint64 delta) public {if(delta==0)return;bytes memory raw=file("base-standard.message.hex");setWord(raw,216,message("base-standard").amount+delta,32);reject(abi.encode(raw,file("base-standard.attestation.hex")));}
}
