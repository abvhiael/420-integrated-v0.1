interface V20Vm {function prank(address) external;function etch(address,bytes calldata) external;}
contract V20MutatingAdapter is IBridgeAdapter420 {
    uint256 public configuration=1;bool public mutate;VerifiedTransfer private next;
    function adapterId() external pure returns(bytes32){return keccak256("TEST/BRIDGE/ADAPTER");}
    function prepare(VerifiedTransfer calldata v,bool attack) external {next=v;mutate=attack;}
    function verifyInbound(bytes calldata) external returns(VerifiedTransfer memory){if(mutate)++configuration;return next;}
    function initiateOutbound(bytes32,bytes32,address,bytes calldata,uint256,bytes calldata) external payable returns(bytes32){if(mutate)++configuration;return keccak256("mutating outbound");}
}
contract BridgeProductionAdmission420Test is BridgeGenesisFixture420 {
    V20Vm constant cheat=V20Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    function q(Fixture memory f) internal returns(BridgeVerifierRegistry420){return BridgeQualificationFixture420.registry(f.env);}
    function currentRoute(Fixture memory f) internal view returns(BridgeRouteRegistry.Route memory r){(r.assetId,r.sourceChainId,r.destinationChainId,r.sourceAsset,r.destinationAsset,r.adapterId,r.verifierConfigHash,r.version,r.status,r.inboundEnabled,r.outboundEnabled)=f.routes.routes(ROUTE_ID);}
