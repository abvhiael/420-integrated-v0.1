    function testV20FreshApprovalAllowsActivationAndAtomicBinding() public {Fixture memory f=_setup();BridgeRouteRegistry.Route memory r=currentRoute(f);r.status=BridgeRouteRegistry.Status.APPROVED_INACTIVE;r.version++;f.routes.setRoute(ROUTE_ID,r);BridgeQualificationFixture420.approveRoute(f.env,f.routes,ROUTE_ID,address(f.adapter),address(f.adapter),0,abi.encodeWithSignature("adapterId()"),abi.encodeWithSignature("adapterId()"),true);f.routes.requireAdmission(ROUTE_ID,ASSET_ID,true);accepted(f);}
    function testV20AdapterRuntimeReplacementRejected() public {Fixture memory f=_setup();cheat.etch(address(f.adapter),hex"60006000fd");(bool ok,)=address(f.router).call(abi.encodeCall(f.router.acceptInbound,(ADAPTER_ID,hex"20")));require(!ok,"runtime substituted");}
