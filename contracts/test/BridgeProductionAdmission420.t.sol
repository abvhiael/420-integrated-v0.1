    function testV20NewApprovalCannotLaunderOldTransferQualification() public {Fixture memory f=_setup();bytes32 id=accepted(f);BridgeQualificationFixture420.approveRoute(f.env,f.routes,ROUTE_ID,address(f.adapter),address(f.adapter),0,abi.encodeWithSignature("adapterId()"),abi.encodeWithSignature("adapterId()"),true);(bool ok,)=address(f.transfers).call(abi.encodeCall(f.transfers.markDestinationPending,(id,keccak256("pending"))));require(!ok,"old proof inherited approval");}
