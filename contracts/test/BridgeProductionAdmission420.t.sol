    function testV20OperatorCannotAssertVerification() public {Fixture memory f=_setup();bytes32 id=accepted(f);f.transfers.markSourceReorg(id,keccak256("reorg"));f.transfers.markRetryable(id,keccak256("retryable"));f.transfers.retry(id,keccak256("retry"));f.transfers.markSourceFinalized(id,keccak256("finalized"));f.transfers.markProofPending(id,keccak256("pending"));(bool ok,)=address(f.transfers).call(abi.encodeCall(f.transfers.markVerified,(id,keccak256("fabricated proof"))));require(!ok,"operator verification bypass");}
