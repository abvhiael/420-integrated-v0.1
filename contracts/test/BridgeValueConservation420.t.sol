 function testDispatchFailureRollsBackActualBurn() public {inbound(100);f.adapter.setFail(false,true);vvm.prank(address(0xB0B));token.approve(address(custody),40);vvm.prank(address(0xB0B));(bool ok,)=address(f.router).call(abi.encodeCall(f.router.initiateFundedOutbound,(ADAPTER_ID,ROUTE_ID,ASSET_ID,hex"0102",40,bytes(""))));require(!ok&&token.totalSupply()==100&&custody.pendingAmount(ASSET_ID)==0);}
 function testUnverifiedOutcomeCannotReleasePendingExposure() public {inbound(100);bytes32 id=withdraw(40);outcome.setReject(true);(bool ok,)=address(f.router).call(abi.encodeCall(f.router.resolveFundedOutbound,(id,receipt(id,true))));require(!ok&&custody.pendingAmount(ASSET_ID)==40);}
 function testReconciliationNumbersCannotHideUnauthorizedMint() public {inbound(100);token.uncontrolledMint(address(0xBAD),1);vvm.warp(block.timestamp+1);f.accounting.applyReconciliation(ASSET_ID,101,101,uint64(block.timestamp),keccak256("privileged equal numbers"));require(!f.accounting.movementHealthy(ASSET_ID));}
 function testLiveProfileCannotBeReplaced() public {inbound(100);(bool ok,)=address(custody).call(abi.encodeCall(custody.configure,(ASSET_ID,address(token),BridgeValueCustody420.Mode.LOCK_RELEASE)));require(!ok);}
