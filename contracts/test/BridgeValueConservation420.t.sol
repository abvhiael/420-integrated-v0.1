 function testFuzzConservationAfterWithdrawal(uint96 value) public {uint256 n=uint256(value)%100+1;inbound(100);bytes32 id=withdraw(n);require(token.totalSupply()+custody.pendingAmount(ASSET_ID)==100);f.router.resolveFundedOutbound(id,receipt(id,true));require(token.totalSupply()==100-n);}
