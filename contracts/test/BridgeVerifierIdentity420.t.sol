    function testProbeReturndataBombFailsBoundedly() public {V19ProbeBomb bomb=new V19ProbeBomb();BridgeVerifierRegistry420.Registration memory r=registration(address(consumer),address(verifier),BridgeVerifierRegistry420.ProxyKind.DIRECT);r.dependencies=new BridgeVerifierRegistry420.Identity[](1);r.dependencies[0]=q.identity(address(bomb),BridgeVerifierRegistry420.ProxyKind.DIRECT);r.probes[0].identity=2;uint256 beforeGas=gasleft();rejectRecord(r);require(beforeGas-gasleft()<300000,"unbounded returndata");}
