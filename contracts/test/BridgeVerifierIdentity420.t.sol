    function testProbeResultSubstitutionRejected() public {BridgeVerifierRegistry420.Registration memory r=registration(address(consumer),address(verifier),BridgeVerifierRegistry420.ProxyKind.DIRECT);r.probes[0].expectedResultHash=bytes32(uint256(1));rejectRecord(r);}
