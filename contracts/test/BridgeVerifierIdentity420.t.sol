    function testWrongRouteConfigurationAndChainRejected() public {approved();(bool ok,)=address(q).staticcall(abi.encodeCall(q.requireRoute,(address(consumer),uint64(1),uint64(block.chainid),keccak256("wrong config"),uint8(1))));require(!ok);(ok,)=address(q).staticcall(abi.encodeCall(q.requireRoute,(address(consumer),uint64(2),uint64(block.chainid),keccak256("config"),uint8(1))));require(!ok);}
