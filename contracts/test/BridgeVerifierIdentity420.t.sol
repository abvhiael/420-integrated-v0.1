interface V19Vm {function prank(address) external;function etch(address,bytes calldata) external;function warp(uint256) external;function chainId(uint256) external;function readFile(string calldata) external view returns(string memory);function parseBytes(string calldata) external pure returns(bytes memory);}
contract V19Verifier is IVerifiedGatewayVerifier420 {
    bytes32 public trustedRoot=keccak256("controlled root");bytes32 public configuration=keccak256("controlled config");uint256 public revision;
    function initialize(bytes32 root,bytes32 config) external {require(trustedRoot==0);trustedRoot=root;configuration=config;}
    function configure(bytes32 root,bytes32 config) external {trustedRoot=root;configuration=config;++revision;}
    function configurationState() external view returns(bytes32){return keccak256(abi.encode(configuration,revision));}
    function verifyDeposit(bytes calldata) external pure returns(bytes32,address,address,uint256){return(keccak256("source note"),address(0xB0B),address(0xCA420),100);}
    function verifyWithdrawal(bytes calldata) external pure returns(bytes32,address,address,uint256){return(keccak256("source note"),address(0xB0B),address(0xCA420),100);}
}
contract V19Consumer {
    address public verifier;address public immutable decoy;constructor(address v){verifier=v;decoy=v;}function setVerifier(address v) external{verifier=v;}
}
contract V19ProbeBomb { fallback() external {assembly{return(0,8192)}} }
contract V19SpoofProxy {address public implementation;uint256 public implementationVersion=1;constructor(address i){implementation=i;} }
contract V19BadInitializer {function initialize() external {bytes32 slot=bytes32(uint256(keccak256("eip1967.proxy.implementation"))-1);assembly{sstore(slot,1)}}}
abstract contract V19Fixture {
    V19Vm constant vm=V19Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    bytes32 constant SRC=keccak256("source");bytes32 constant DST=keccak256("destination");bytes32 constant ASSET=keccak256("asset");
    GenesisMockEnvironment420 env;BridgeChainRegistry420 chains;BridgeVerifierRegistry420 q;V19Verifier verifier;V19Consumer consumer;
    function setUp() public {env=new GenesisMockEnvironment420();chains=new BridgeChainRegistry420(address(this),address(env.registry()),keccak256("chains"));env.registerResident(address(chains),chains.componentId());chains.setChain(SRC,_chain(1,keccak256("source-mainnet")));chains.setChain(DST,_chain(uint64(block.chainid),keccak256("local-genesis")));q=new BridgeVerifierRegistry420(address(this),address(env.registry()),keccak256("identity"));env.registerResident(address(q),q.componentId());verifier=new V19Verifier();consumer=new V19Consumer(address(verifier));}
    function _chain(uint64 id,bytes32 network) internal pure returns(BridgeChainRegistry420.Chain memory){return BridgeChainRegistry420.Chain(id,network,ASSET,keccak256("qualified family"),BridgeChainRegistry420.ChainFamily.EVM,true);}
    function registration(address c,address v,BridgeVerifierRegistry420.ProxyKind kind) internal view returns(BridgeVerifierRegistry420.Registration memory r){
        r.consumer=q.identity(c,BridgeVerifierRegistry420.ProxyKind.DIRECT);r.verifier=q.identity(v,kind);r.verifierGetter=bytes4(keccak256("verifier()"));r.sourceChainKey=SRC;r.destinationChainKey=DST;r.proofSystem=keccak256("controlled system");r.configurationHash=keccak256("config");r.evidenceHash=keccak256("CONTROLLED TEST QUALIFICATION ONLY");r.directions=3;r.dependencies=new BridgeVerifierRegistry420.Identity[](0);r.probes=new BridgeVerifierRegistry420.Probe[](2);
        bytes memory root=abi.encodeWithSignature("trustedRoot()");bytes memory config=abi.encodeWithSignature("configurationState()");r.probes[0]=BridgeVerifierRegistry420.Probe(1,true,root,BridgeQualificationFixture420.resultHash(v,root));r.probes[1]=BridgeVerifierRegistry420.Probe(1,false,config,BridgeQualificationFixture420.resultHash(v,config));
    }
    function approved() internal returns(bytes32){return q.record(registration(address(consumer),address(verifier),BridgeVerifierRegistry420.ProxyKind.DIRECT),q.currentApproval(address(consumer)),true);}
    function rejectRecord(BridgeVerifierRegistry420.Registration memory r) internal {(bool ok,)=address(q).call(abi.encodeCall(q.record,(r,q.currentApproval(r.consumer.target),true)));require(!ok,"invalid registration accepted");}
}
contract BridgeVerifierIdentity420Test is V19Fixture {
