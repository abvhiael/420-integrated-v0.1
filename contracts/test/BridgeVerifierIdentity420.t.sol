    function testFuzzWrongRootCannotKeepQualification(bytes32 root) public {bytes32 old=verifier.trustedRoot();if(root==old)root=bytes32(uint256(root)^1);approved();verifier.configure(root,verifier.configuration());require(!q.isCurrent(address(consumer)));}
