    function testUnknownPublicProxyRuntimeCannotAuthenticateItself() public {address proxy=nativeCircleProxy();(bool ok,)=address(q).staticcall(abi.encodeCall(q.identity,(proxy,BridgeVerifierRegistry420.ProxyKind.AUDITED_PUBLIC)));require(!ok);}
