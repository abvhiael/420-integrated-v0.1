    function testLegacyTupleGatewayCannotBeRevivedByQualificationOrReplacement() public {VerifiedGateway420 gateway=new VerifiedGateway420(address(this),address(env.registry()),keccak256("gateway"),address(verifier));env.registerResident(address(gateway),gateway.componentId());env.setSettlementAsset(address(0xCA420),ASSET,true);gateway.setAsset(address(0xCA420),true);bytes32 id=q.record(registration(address(gateway),address(verifier),BridgeVerifierRegistry420.ProxyKind.DIRECT),0,true);gateway.bindQualification(id);(bool legacyOk,)=address(gateway).call(abi.encodeCall(gateway.verifyDeposit,(hex"01")));require(!legacyOk,"legacy source domain bypass");V19Verifier other=new V19Verifier();gateway.setVerifier(address(other));(bool ok,)=address(gateway).call(abi.encodeCall(gateway.verifyDeposit,(hex"01")));require(!ok,"replacement inherited approval");id=q.record(registration(address(gateway),address(other),BridgeVerifierRegistry420.ProxyKind.DIRECT),id,true);gateway.bindQualification(id);(ok,)=address(gateway).call(abi.encodeCall(gateway.verifyDeposit,(hex"01")));require(!ok,"rotation replay");(ok,)=address(gateway).call(abi.encodeCall(gateway.verifyWithdrawal,(hex"01")));require(!ok,"cross direction replay");}
