    function testProxyRuntimeProfilesRequireGovernance() public {vm.prank(address(0xBAD));(bool ok,)=address(q).call(abi.encodeCall(q.qualifyProxyRuntime,(address(verifier).codehash,keccak256("evidence"),true)));require(!ok);}
    function testManagedProxyCannotDowngradeToPublicGetterProfile() public {BridgeVerifierProxy420 proxy=_proxy();q.qualifyProxyRuntime(address(proxy).codehash,keccak256("profile"),true);(bool ok,)=address(q).staticcall(abi.encodeCall(q.identity,(address(proxy),BridgeVerifierRegistry420.ProxyKind.AUDITED_PUBLIC)));require(!ok);}
    function testDecoyGetterCannotHideActualVerifierReplacement() public {BridgeVerifierRegistry420.Registration memory r=registration(address(consumer),address(verifier),BridgeVerifierRegistry420.ProxyKind.DIRECT);r.verifierGetter=bytes4(keccak256("decoy()"));rejectRecord(r);}
    function testSelfModeCannotOmitAnExposedExternalVerifier() public {BridgeVerifierRegistry420.Registration memory r=registration(address(consumer),address(verifier),BridgeVerifierRegistry420.ProxyKind.DIRECT);r.verifier=r.consumer;r.verifierGetter=0;bytes memory data=abi.encodeWithSignature("verifier()");r.probes[0]=BridgeVerifierRegistry420.Probe(1,true,data,BridgeQualificationFixture420.resultHash(address(consumer),data));r.probes[1]=BridgeVerifierRegistry420.Probe(1,false,data,BridgeQualificationFixture420.resultHash(address(consumer),data));rejectRecord(r);}
