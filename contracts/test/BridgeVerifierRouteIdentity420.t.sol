pragma solidity ^0.8.24;
import "./BridgeGenesisIntegration420.t.sol";
contract BridgeVerifierRouteIdentity420Test is BridgeGenesisFixture420 {
    function qualified(Fixture memory f) internal returns(BridgeVerifierRegistry420){return BridgeQualificationFixture420.registry(f.env);}
    function reject(Fixture memory f) internal {(bool ok,)=address(f.router).call(abi.encodeCall(f.router.acceptInbound,(ADAPTER_ID,hex"01")));require(!ok,"rejected proof unexpectedly executed");}
    function replacement(Fixture memory f) internal returns(MockBridgeAdapter420 other){other=new MockBridgeAdapter420();f.router.setAdapter(ADAPTER_ID,address(other));}
    function qualify(Fixture memory f,address adapter) internal returns(bytes32){return BridgeQualificationFixture420.approveRoute(f.env,f.routes,ROUTE_ID,adapter,adapter,0,abi.encodeWithSignature("adapterId()"),abi.encodeWithSignature("adapterId()"),true);}
    function route(Fixture memory f,uint32 version) internal view returns(BridgeRouteRegistry.Route memory r){(r.assetId,r.sourceChainId,r.destinationChainId,r.sourceAsset,r.destinationAsset,r.adapterId,r.verifierConfigHash,r.version,r.status,r.inboundEnabled,r.outboundEnabled)=f.routes.routes(ROUTE_ID);r.version=version;}
    function testV19UnqualifiedReplacementAdapterNeverExecutes() public {Fixture memory f=_setup();MockBridgeAdapter420 other=replacement(f);other.setInbound(_inbound(1));reject(f);}
    function testV19IdenticalCodeReplacementRequiresNewRouteBinding() public {Fixture memory f=_setup();MockBridgeAdapter420 other=replacement(f);other.setInbound(_inbound(1));BridgeQualificationFixture420.approveRoute(f.env,f.routes,ROUTE_ID,address(other),address(other),0,abi.encodeWithSignature("adapterId()"),abi.encodeWithSignature("adapterId()"),false);reject(f);f.routes.bindVerifier(ROUTE_ID,qualified(f).currentApproval(address(other)));f.router.acceptInbound(ADAPTER_ID,hex"01");}
    function testV19RevocationStopsInboundAndOutbound() public {Fixture memory f=_setup();BridgeVerifierRegistry420 q=qualified(f);f.adapter.setInbound(_inbound(1));q.revoke(q.currentApproval(address(f.adapter)),keccak256("revoked evidence"));reject(f);(bool ok,)=address(f.router).call(abi.encodeCall(f.router.initiateOutbound,(ADAPTER_ID,ROUTE_ID,ASSET_ID,hex"01",uint256(1),hex"")));require(!ok);}
    function testV19NewQualificationDoesNotReactivateOldRouteBinding() public {Fixture memory f=_setup();BridgeVerifierRegistry420 q=qualified(f);f.adapter.setInbound(_inbound(1));BridgeVerifierRegistry420.Registration memory r=abi.decode(q.registration(q.currentApproval(address(f.adapter))),(BridgeVerifierRegistry420.Registration));bytes32 next=q.record(r,q.currentApproval(address(f.adapter)),true);reject(f);f.routes.bindVerifier(ROUTE_ID,next);f.router.acceptInbound(ADAPTER_ID,hex"01");}
    function testV19RouteVersionChangeRequiresNewQualification() public {Fixture memory f=_setup();BridgeVerifierRegistry420 q=qualified(f);bytes32 old=q.currentApproval(address(f.adapter));f.routes.setRoute(ROUTE_ID,route(f,2));(bool ok,)=address(f.routes).call(abi.encodeCall(f.routes.bindVerifier,(ROUTE_ID,old)));require(!ok,"changed route inherited approval");qualify(f,address(f.adapter));f.adapter.setInbound(_inbound(1));f.router.acceptInbound(ADAPTER_ID,hex"01");}
    function testV19ChainRevisionInvalidatesRouteUntilRequalified() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(1));f.chains.setChain(EXTERNAL_CHAIN,_chain(1,EXTERNAL_NETWORK,true));reject(f);qualify(f,address(f.adapter));f.router.acceptInbound(ADAPTER_ID,hex"01");}
    function testV19RegistryReplacementNeedsFreshApprovalAndBinding() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(1));BridgeVerifierRegistry420 other=new BridgeVerifierRegistry420(address(this),address(f.env.registry()),keccak256("replacement"));f.env.registerResident(address(other),other.componentId());reject(f);qualify(f,address(f.adapter));f.router.acceptInbound(ADAPTER_ID,hex"01");}
    function testV19ReplaySurvivesApprovedAdapterReplacementAndChangedAmount() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(1));f.router.acceptInbound(ADAPTER_ID,hex"01");MockBridgeAdapter420 other=replacement(f);qualify(f,address(other));IBridgeAdapter420.VerifiedTransfer memory v=_inbound(2);v.recipient=address(0x123);other.setInbound(v);reject(f);(,,,,,,uint256 tvl)=f.risk.routeUsage(ROUTE_ID);require(tvl==1,"replay changed risk");}
    function testV19ReplaySurvivesQualificationRegistryReplacement() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(1));f.router.acceptInbound(ADAPTER_ID,hex"01");BridgeVerifierRegistry420 other=new BridgeVerifierRegistry420(address(this),address(f.env.registry()),keccak256("replacement"));f.env.registerResident(address(other),other.componentId());qualify(f,address(f.adapter));IBridgeAdapter420.VerifiedTransfer memory v=_inbound(2);f.adapter.setInbound(v);reject(f);}
    function testV19LateFailureRollsBackCentralReplayKey() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(1));f.transfers.setRouter(address(f.router),false);reject(f);f.transfers.setRouter(address(f.router),true);f.router.acceptInbound(ADAPTER_ID,hex"01");}
    function testV19UnqualifiedProofCannotConsumeReplay() public {Fixture memory f=_setup();BridgeVerifierRegistry420 q=qualified(f);q.revoke(q.currentApproval(address(f.adapter)),keccak256("revoke"));f.adapter.setInbound(_inbound(1));reject(f);qualify(f,address(f.adapter));f.router.acceptInbound(ADAPTER_ID,hex"01");}
    function testV19SourceChainAliasCannotResetCanonicalMessageReplay() public {Fixture memory f=_setup();f.adapter.setInbound(_inbound(1));f.router.acceptInbound(ADAPTER_ID,hex"01");f.chains.setChain(EXTERNAL_CHAIN,_chain(1002,EXTERNAL_NETWORK,true));f.chains.setChain(keccak256("same network new canonical key"),_chain(1,EXTERNAL_NETWORK,true));f.routes.setRoute(ROUTE_ID,route(f,2));qualify(f,address(f.adapter));f.adapter.setInbound(_inbound(2));reject(f);}
    function testV19OnlyGovernanceCanBindQualification() public {Fixture memory f=_setup();bytes32 id=qualified(f).currentApproval(address(f.adapter));V19RouteVm(address(uint160(uint256(keccak256("hevm cheat code"))))).prank(address(0xBAD));(bool ok,)=address(f.routes).call(abi.encodeCall(f.routes.bindVerifier,(ROUTE_ID,id)));require(!ok);}
}
interface V19RouteVm {function prank(address) external;}
