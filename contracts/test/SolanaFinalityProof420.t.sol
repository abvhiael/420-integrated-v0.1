pragma solidity ^0.8.24;
import "./helpers/TokenPolicyBoundaryFixture420.sol";
import "../src/bridge/verifiers/SolanaFinalityVerifier420.sol";
import "../src/bridge/adapters/SolanaBridgeAdapter420.sol";
interface SolanaProofVm420 {function readFileBinary(string calldata) external view returns(bytes memory);function etch(address,bytes calldata) external;function chainId(uint256) external;}
contract SolanaProofRouter420 {function inbound(SolanaBridgeAdapter420 a,bytes calldata p) external returns(IBridgeAdapter420.VerifiedTransfer memory){return a.verifyInbound(p);}}
contract SolanaFinalityProof420Test {
 SolanaProofVm420 constant vm=SolanaProofVm420(address(uint160(uint256(keccak256("hevm cheat code")))));
 address constant Q=address(0x7000);address constant R=address(0x420420);
 struct Fixture {SolanaFinalityVerifier420.Proof proof;SolanaValidatorQuorum420.Claim claim;SolanaValidatorQuorum420.Vote[] votes;bytes32 root;bytes32 snapshot;bytes32 vault;bytes32 state;}
 function fixture(string memory name) internal view returns(Fixture memory f){(f.proof,f.claim,f.votes,f.root,f.snapshot,f.vault,f.state)=abi.decode(vm.readFileBinary(string.concat("contracts/test/fixtures/solana/controlled-",name,".bin")),(SolanaFinalityVerifier420.Proof,SolanaValidatorQuorum420.Claim,SolanaValidatorQuorum420.Vote[],bytes32,bytes32,bytes32,bytes32));}
 function setup(Fixture memory f) internal returns(SolanaValidatorQuorum420 q,SolanaFinalityVerifier420 v,SolanaBridgeAdapter420 a){vm.chainId(420);SolanaValidatorQuorum420 impl=new SolanaValidatorQuorum420(address(this));vm.etch(Q,address(impl).code);q=SolanaValidatorQuorum420(Q);(bytes32 root,,,)=q.epochs(1086);if(root==0)q.installEpoch(1086,f.root,f.snapshot,100);else require(root==f.root);vm.etch(R,address(new SolanaProofRouter420()).code);v=new SolanaFinalityVerifier420(address(this),Q,R);configure(v,f);a=new SolanaBridgeAdapter420(address(this),R,address(v));
        a.setTokenRoutePolicy(address(new TokenPolicyBoundaryFixture420()));a.setGatewayProgram(f.proof.execution.gatewayProgram,true);bytes32 asset=keccak256(abi.encode("controlled asset",f.proof.execution.sourceAsset));a.setAssetMapping(f.proof.execution.sourceAsset,asset,true);a.setRouteBinding(asset,f.proof.execution.routeId);}
 function configure(SolanaFinalityVerifier420 v,Fixture memory f) internal {v.setProgram(f.proof.execution.gatewayProgram,f.proof.execution.gatewayCodeHash);v.setAsset(f.proof.execution.sourceAsset,f.proof.execution.routeId);v.setVault(f.proof.execution.gatewayProgram,f.proof.execution.sourceAsset,f.vault);v.setDepositState(f.proof.execution.gatewayProgram,f.proof.execution.sourceAsset,f.state);}
 function certify(SolanaValidatorQuorum420 q,Fixture memory f) internal {for(uint256 i;i<f.votes.length;++i)if(f.votes[i].stake==40 || f.votes[i].stake==30)q.submitVote(f.claim,f.votes[i]);require(q.isCertified(f.claim));}
 function fail(address target,bytes memory data) internal {(bool ok,)=target.call(data);require(!ok,"unsupported evidence accepted");}
 function testControlledNativeActualSignaturesQuorumAndReplayAcrossVerifierRotation() public {Fixture memory f=fixture("native");(SolanaValidatorQuorum420 q,SolanaFinalityVerifier420 v,SolanaBridgeAdapter420 a)=setup(f);certify(q,f);IBridgeAdapter420.VerifiedTransfer memory t=SolanaProofRouter420(R).inbound(a,abi.encode(f.proof));require(t.amount==f.proof.execution.amount && t.recipient==f.proof.execution.recipient && t.sourceMessageId==v.messageId(f.proof.execution) && t.sourceTxId==sha256(SolanaTransaction420.cut(f.proof.transaction,1,64)));require(a.sourceOwnerByMessage(t.sourceMessageId)==f.proof.execution.sourceOwner);SolanaFinalityVerifier420 replacement=new SolanaFinalityVerifier420(address(this),Q,R);configure(replacement,f);a.setVerifier(address(replacement));fail(R,abi.encodeCall(SolanaProofRouter420.inbound,(a,abi.encode(f.proof))));}
 function testControlledCanonicalRayAndEurcMintRoutes() public {for(uint256 i;i<2;++i){Fixture memory f=fixture(i==0?"ray":"eurc");(SolanaValidatorQuorum420 q,,SolanaBridgeAdapter420 a)=setup(f);certify(q,f);IBridgeAdapter420.VerifiedTransfer memory t=SolanaProofRouter420(R).inbound(a,abi.encode(f.proof));require(t.amount==42000000 && t.routeId==f.proof.execution.routeId);}}
 function testControlledV0AndV0AuthenticatedLoadedAddressesAndV1() public {string[3] memory names=[string("native-v0"),"native-v0-lut","native-v1"];for(uint256 i;i<3;++i){Fixture memory f=fixture(names[i]);(SolanaValidatorQuorum420 q,SolanaFinalityVerifier420 v,)=setup(f);certify(q,f);ISolanaFinalityVerifier420.FinalizedTransfer memory t=v.verifyFinalizedTransfer(abi.encode(f.proof));require(t.finalized && t.sourceOwner==f.proof.execution.sourceOwner);}}
 function testIncorrectClaimStillFailsWithValidControlledQuorumCertificate() public {string[4] memory names=[string("native-bad-data"),"native-bad-owner","native-failed","ray-mint-substitution"];for(uint256 i;i<4;++i){Fixture memory f=fixture(names[i]);(SolanaValidatorQuorum420 q,SolanaFinalityVerifier420 v,)=setup(f);certify(q,f);fail(address(v),abi.encodeCall(v.verifyFinalizedTransfer,(abi.encode(f.proof))));}}
 function testRpcOnlyAndUncertifiedExecutionNeverFinalizes() public {Fixture memory f=fixture("native");(,SolanaFinalityVerifier420 v,)=setup(f);fail(address(v),abi.encodeCall(v.verifyFinalizedTransfer,(abi.encode(f.proof))));fail(address(v),abi.encodeCall(v.verifyFinalizedTransfer,(bytes('{"confirmationStatus":"finalized","err":null}'))));}
 function testThresholdDuplicateVoteAndForgedStake() public {Fixture memory f=fixture("native");(SolanaValidatorQuorum420 q,,)=setup(f);for(uint256 i;i<f.votes.length;++i)if(f.votes[i].stake==40 || f.votes[i].stake==20)q.submitVote(f.claim,f.votes[i]);require(!q.isCertified(f.claim));for(uint256 i;i<f.votes.length;++i){if(f.votes[i].stake==40)fail(Q,abi.encodeCall(q.submitVote,(f.claim,f.votes[i])));if(f.votes[i].stake==30){SolanaValidatorQuorum420.Vote memory bad=f.votes[i];bad.stake=100;fail(Q,abi.encodeCall(q.submitVote,(f.claim,bad)));}}}
 function testEpochRootImmutableAndRevocationInvalidatesCertificate() public {Fixture memory f=fixture("native");(SolanaValidatorQuorum420 q,SolanaFinalityVerifier420 v,)=setup(f);certify(q,f);fail(Q,abi.encodeCall(q.installEpoch,(uint64(1086),f.root,f.snapshot,uint64(100))));q.disableEpoch(1086);require(!q.isCertified(f.claim));fail(address(v),abi.encodeCall(v.verifyFinalizedTransfer,(abi.encode(f.proof))));}
 function testCertifiedBankCannotBeReplaced() public {Fixture memory f=fixture("native");(SolanaValidatorQuorum420 q,,)=setup(f);certify(q,f);Fixture memory conflict=fixture("native-conflicting-bank");fail(Q,abi.encodeCall(q.submitVote,(conflict.claim,conflict.votes[0])));require(q.finalizedBanks(f.claim.slot)==f.claim.bankHash);}
 function testPreparedMaximumV1MultisigProofFitsTransactionBudget() public {Fixture memory f=fixture("native-v1-multisig");(SolanaValidatorQuorum420 q,SolanaFinalityVerifier420 v,)=setup(f);certify(q,f);bytes memory raw=f.proof.transaction;require(raw.length==4096);uint256 sigAt=raw.length-12*64;bytes memory message=SolanaTransaction420.cut(raw,0,sigAt);SolanaEd25519420 ed=q.ed();for(uint256 i;i<12;++i){uint256 beforeGas=gasleft();ed.certify(SolanaTransaction420.word(raw,42+i*32),message,SolanaTransaction420.cut(raw,sigAt+i*64,64));require(beforeGas-gasleft()<30000000);}uint256 g=gasleft();ISolanaFinalityVerifier420.FinalizedTransfer memory t=v.verifyFinalizedTransfer(abi.encode(f.proof));require(t.finalized && g-gasleft()<30000000);}
 function testCrossInstanceAndCrossChainCertificatesRejected() public {Fixture memory f=fixture("native");(SolanaValidatorQuorum420 q,,)=setup(f);SolanaValidatorQuorum420 other=new SolanaValidatorQuorum420(address(this));other.installEpoch(1086,f.root,f.snapshot,100);fail(address(other),abi.encodeCall(other.submitVote,(f.claim,f.votes[0])));vm.chainId(421);fail(Q,abi.encodeCall(q.submitVote,(f.claim,f.votes[0])));vm.chainId(420);certify(q,f);require(q.isCertified(f.claim));}
 function testStatementAndAuthorityCannotBeSubstituted() public {Fixture memory f=fixture("native");(SolanaValidatorQuorum420 q,,)=setup(f);SolanaValidatorQuorum420.Claim memory wrong=f.claim;wrong.transactionHash=sha256("different transaction");fail(Q,abi.encodeCall(q.submitVote,(wrong,f.votes[0])));SolanaValidatorQuorum420.Vote memory bad=f.votes[0];bad.authorizedVoter=sha256("wrong vote authority");fail(Q,abi.encodeCall(q.submitVote,(f.claim,bad)));}

 function testCertifiedCpiPdaOwnerAndUncommittedInvocation() public {Fixture memory f=fixture("native-cpi");(SolanaValidatorQuorum420 q,SolanaFinalityVerifier420 v,)=setup(f);certify(q,f);ISolanaFinalityVerifier420.FinalizedTransfer memory result=v.verifyFinalizedTransfer(abi.encode(f.proof));require(result.sourceOwner==f.proof.execution.sourceOwner && result.finalized);Fixture memory bad=fixture("native-cpi-uncommitted");certify(q,bad);fail(address(v),abi.encodeCall(v.verifyFinalizedTransfer,(abi.encode(bad.proof))));}

}
