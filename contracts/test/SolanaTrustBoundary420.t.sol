pragma solidity ^0.8.24;
import "../src/bridge/verifiers/SolanaFinalityVerifier420.sol";
contract SolanaUnauthorizedCaller420 {function forward(address target,bytes calldata data) external returns(bool ok){(ok,)=target.call(data);}}
contract SolanaTrustBoundary420Test {
 function fail(address target,bytes memory data) internal {(bool ok,)=target.call(data);require(!ok);}
 function testOnlyGovernanceCanInstallRevokeOrConfigureTrust() public {SolanaValidatorQuorum420 q=new SolanaValidatorQuorum420(address(this));SolanaUnauthorizedCaller420 attacker=new SolanaUnauthorizedCaller420();bytes32 root=sha256("controlled root");bytes32 snapshot=sha256("controlled snapshot");require(!attacker.forward(address(q),abi.encodeCall(q.installEpoch,(uint64(1086),root,snapshot,uint64(100)))));q.installEpoch(1086,root,snapshot,100);require(!attacker.forward(address(q),abi.encodeCall(q.disableEpoch,(uint64(1086)))));SolanaFinalityVerifier420 v=new SolanaFinalityVerifier420(address(this),address(q),address(attacker));require(!attacker.forward(address(v),abi.encodeCall(v.setProgram,(root,snapshot))));require(!attacker.forward(address(v),abi.encodeCall(v.setAsset,(root,snapshot))));require(!attacker.forward(address(v),abi.encodeCall(v.setVault,(root,snapshot,root))));require(!attacker.forward(address(v),abi.encodeCall(v.setDepositState,(root,snapshot,root))));require(v.programCodeHashes(root)==0 && v.routes(root)==0);}
 function testUnknownAndMalformedStakeEpochsFailClosed() public {SolanaValidatorQuorum420 q=new SolanaValidatorQuorum420(address(this));bytes32 h=sha256("controlled");fail(address(q),abi.encodeCall(q.installEpoch,(uint64(1086),bytes32(0),h,uint64(100))));fail(address(q),abi.encodeCall(q.installEpoch,(uint64(1086),h,bytes32(0),uint64(100))));fail(address(q),abi.encodeCall(q.installEpoch,(uint64(1086),h,h,uint64(0))));SolanaValidatorQuorum420.Claim memory c=SolanaValidatorQuorum420.Claim(1086,469440001,h,h,h);SolanaValidatorQuorum420.Vote memory vote;fail(address(q),abi.encodeCall(q.submitVote,(c,vote)));require(!q.isCertified(c));}
}
