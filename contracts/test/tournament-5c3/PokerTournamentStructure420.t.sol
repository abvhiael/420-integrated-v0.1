    function testFuzzFundedReceiptReservationsConserveMoney(uint128 stack,uint8 loops)public{if(stack==0)stack=1;PokerTournamentPolicy420.Config memory c=config();c.startingStack=stack;_event(c);uint64 n=uint64(loops%8)+1;for(uint64 i=1;i<=n;i++){_buy(alice,A,AC,i);_reserve(alice,i);require(book.reservedChips(EVENT)==stack&&book.reservedPlayers(EVENT)==1);alice.invoke(address(escrow),abi.encodeCall(escrow.unregister,(EVENT,i,i)));book.syncReservation(EVENT,i);alice.invoke(address(escrow),abi.encodeCall(escrow.withdraw,()));require(book.reservedChips(EVENT)==0);_invariant();}require(asset.balanceOf(address(alice))==10000&&escrow.totalLiability()==0);}
