    function testEmptyAndOversizedSchedulesRejected()public{PokerTournamentStructure420.Level[] memory empty=new PokerTournamentStructure420.Level[](0);_reject(address(book),abi.encodeCall(book.register,(STRUCTURE,OP,uint128(1000),empty)));PokerTournamentStructure420.Level[] memory huge=new PokerTournamentStructure420.Level[](257);_reject(address(book),abi.encodeCall(book.register,(STRUCTURE,OP,uint128(1000),huge)));}
    function testMaximumSupportedScheduleIsRepresentable()public{PokerTournamentStructure420.Level[] memory list=new PokerTournamentStructure420.Level[](256);for(uint256 i;i<list.length;i++)list[i]=PokerTournamentStructure420.Level(5,10,type(uint32).max);book.register(STRUCTURE,OP,1000,list);require(book.structureOf(STRUCTURE).levelCount==256&&book.structureOf(STRUCTURE).duration==uint64(type(uint32).max)*256&&book.levelAt(STRUCTURE,type(uint256).max).level==256);}
    function testZeroDurationAndZeroBlindRejected()public{PokerTournamentStructure420.Level[] memory l=levels();l[1].duration=0;_reject(address(book),abi.encodeCall(book.register,(STRUCTURE,OP,uint128(1000),l)));l=levels();l[0].smallBlind=0;_reject(address(book),abi.encodeCall(book.register,(STRUCTURE,OP,uint128(1000),l)));}
    function testBlindDecreaseAndWrongRatioRejected()public{PokerTournamentStructure420.Level[] memory l=levels();l[2]=PokerTournamentStructure420.Level(5,10,60);_reject(address(book),abi.encodeCall(book.register,(STRUCTURE,OP,uint128(1000),l)));l=levels();l[1].bigBlind=21;_reject(address(book),abi.encodeCall(book.register,(STRUCTURE,OP,uint128(1000),l)));}
