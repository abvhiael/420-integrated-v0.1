pragma solidity ^0.8.24;
import "../../src/bet/tournament/PokerTournamentStructureBook420.sol";
import "../tournament-5c2/PokerTournamentEntryEscrow420.t.sol";
interface IStructureVm420 {function chainId(uint256) external;}

/// @dev Pure/native mechanics harness, not a hand/proof verifier or deployment host.
contract StructureMechanicsHarness420 {
    using PokerTournamentStructure420 for PokerTournamentStructure420.Clock;
    using PokerTournamentStructure420 for PokerTournamentStructure420.Hands;
    PokerTournamentStructure420.Clock private clock;
    PokerTournamentStructure420.Hands private hands;
    PokerTournamentStructure420.Level[] private levels;
    constructor(PokerTournamentStructure420.Level[] memory list){PokerTournamentStructure420.validate(1000,list);for(uint256 i;i<list.length;i++)levels.push(list[i]);}
    function validate(uint128 stack,PokerTournamentStructure420.Level[] calldata list)external pure returns(uint64){return PokerTournamentStructure420.validate(stack,list);}
    function at(uint256 t)external view returns(PokerTournamentStructure420.Position memory){return PokerTournamentStructure420.at(levels,t);}
    function start(uint256 t)external{clock.start(keccak256("frozen event+structure manifest"),9,1000,levels,t);}
    function startWithPolicy(bytes32 context,uint16 tables,uint32 recovery,uint256 t)external{clock.start(context,tables,recovery,levels,t);}
    function pause(uint256 t,uint32 recovery)external{clock.pause(t,recovery);}
    function resume(uint256 t,uint32 recovery)external{clock.resume(t,recovery);}
    function observe(uint256 t,uint32 recovery)external{clock.observe(t,recovery);}
    function finish(uint256 t,uint32 recovery)external{clock.finish(hands,t,recovery);}
    function elapsed(uint256 t)external view returns(uint256){return clock.elapsed(t);}
    function clockOf()external view returns(PokerTournamentStructure420.Clock memory){return clock;}
    function lock(bytes32 context,bytes32 table,bytes32 hand,uint256 t)external returns(PokerTournamentStructure420.Hand memory){return hands.lock(clock,levels,context,table,hand,t);}
    function lockWithSchedule(bytes32 context,bytes32 table,bytes32 hand,uint256 t,PokerTournamentStructure420.Level[] calldata list)external returns(PokerTournamentStructure420.Hand memory){return hands.lock(clock,list,context,table,hand,t);}
    function close(bytes32 context,bytes32 table,bytes32 hand)external{hands.close(context,table,hand);}
    function handOf(bytes32 id)external view returns(PokerTournamentStructure420.Hand memory){return hands.byId[id];}
    function active(bytes32 table)external view returns(bytes32){return hands.activeForTable[table];}
    function post(PokerTournamentStructure420.Hand calldata hand,uint16 mask,uint8 button,uint256[9] calldata stacks)external pure returns(uint8,uint8,uint256[9] memory,uint256[9] memory,uint256){return PokerTournamentStructure420.post(hand,mask,button,stacks);}
}
abstract contract StructureTestBase420 {
    bytes32 internal constant CONTEXT=keccak256("frozen event+structure manifest");bytes32 internal constant TABLE=keccak256("table one");bytes32 internal constant HAND=keccak256("hand one");
    StructureMechanicsHarness420 internal mechanics;
    function levels()internal pure returns(PokerTournamentStructure420.Level[] memory l){l=new PokerTournamentStructure420.Level[](3);l[0]=PokerTournamentStructure420.Level(5,10,60);l[1]=PokerTournamentStructure420.Level(10,20,120);l[2]=PokerTournamentStructure420.Level(20,40,180);}
    function setUp()public virtual{mechanics=new StructureMechanicsHarness420(levels());}
    function fail(bytes memory data)internal{(bool ok,)=address(mechanics).call(data);require(!ok,"unexpected mechanics acceptance");}
}
contract TournamentStructureClock420Test is StructureTestBase420 {
    function testZeroElapsedStartsAtLevelOne()public view{PokerTournamentStructure420.Position memory p=mechanics.at(0);require(p.level==1&&p.smallBlind==5&&p.bigBlind==10&&p.remaining==60);}
    function testExactBoundaryAdvancesNextHandLevel()public view{require(mechanics.at(59).level==1&&mechanics.at(60).level==2&&mechanics.at(180).level==3);}
    function testLateQueryCatchesUpWithoutOperatorSteps()public view{require(mechanics.at(179).level==2&&mechanics.at(359).level==3&&mechanics.at(999999).level==3);}
    function testFinalLevelHeldWithoutArtificialWinner()public view{PokerTournamentStructure420.Position memory p=mechanics.at(type(uint256).max);require(p.finalLevel&&p.level==3&&p.bigBlind==40&&p.remaining==0);}
    function testClockCannotStartTwiceOrAtZero()public{fail(abi.encodeCall(mechanics.start,(uint256(0))));mechanics.start(100);fail(abi.encodeCall(mechanics.start,(uint256(101))));}
    function testUnstartedClockCannotProgress()public{fail(abi.encodeCall(mechanics.elapsed,(uint256(100))));fail(abi.encodeCall(mechanics.pause,(uint256(100),uint32(1000))));}
    function testClockRejectsTimestampTruncationAndRewind()public{fail(abi.encodeCall(mechanics.start,(uint256(type(uint64).max)+1)));mechanics.start(100);mechanics.observe(200,1000);fail(abi.encodeCall(mechanics.observe,(uint256(199),uint32(1000))));}
    function testPauseFreezesLevelWhileWallTimeAdvances()public{mechanics.start(100);mechanics.pause(159,1000);require(mechanics.elapsed(700)==59);require(mechanics.at(mechanics.elapsed(700)).level==1);}
    function testResumePreservesOnlyPlayingSeconds()public{mechanics.start(100);mechanics.pause(159,1000);mechanics.resume(200,1000);require(mechanics.elapsed(201)==60&&mechanics.at(mechanics.elapsed(201)).level==2);}
    function testRepeatedPausesAccumulateWithoutResettingRecovery()public{mechanics.startWithPolicy(CONTEXT,9,100,100);mechanics.pause(110,100);mechanics.resume(120,100);mechanics.pause(130,100);mechanics.resume(140,100);require(mechanics.elapsed(150)==30&&mechanics.clockOf().firstPause==110);}
    function testExactRecoveryDeadlineFailsClosed()public{mechanics.startWithPolicy(CONTEXT,9,100,100);mechanics.pause(110,100);mechanics.observe(210,100);require(mechanics.clockOf().state==PokerTournamentStructure420.State.RECOVERY_REQUIRED);fail(abi.encodeCall(mechanics.resume,(uint256(210),uint32(100))));}
    function testRepeatedPauseCannotExtendOriginalRecoveryDeadline()public{mechanics.startWithPolicy(CONTEXT,9,100,100);mechanics.pause(110,100);mechanics.resume(120,100);mechanics.pause(205,100);mechanics.observe(210,100);require(mechanics.clockOf().state==PokerTournamentStructure420.State.RECOVERY_REQUIRED&&mechanics.elapsed(500)==95);}
    function testZeroRecoveryPolicyRejected()public{mechanics.start(100);fail(abi.encodeCall(mechanics.pause,(uint256(110),uint32(0))));}
    function testPauseAndResumeRequireTheirCorrectStates()public{mechanics.start(100);fail(abi.encodeCall(mechanics.resume,(uint256(110),uint32(1000))));mechanics.pause(110,1000);fail(abi.encodeCall(mechanics.pause,(uint256(120),uint32(1000))));}
    function testHardPurchaseDeadlineDoesNotUsePausedSeconds()public{mechanics.start(100);mechanics.pause(150,1000);require(mechanics.elapsed(300)==50);require(!PokerTournamentPolicy420.windowOpen(100,200,0,1,300));}
    function testHandSnapshotSurvivesAllLevelChanges()public{mechanics.start(100);PokerTournamentStructure420.Hand memory h=mechanics.lock(CONTEXT,TABLE,HAND,159);mechanics.observe(1000,1000);PokerTournamentStructure420.Hand memory old=mechanics.handOf(HAND);require(old.digest==h.digest&&old.level==1&&old.bigBlind==10&&mechanics.at(mechanics.elapsed(1000)).bigBlind==40);}
    function testEveryTableUsesCommonClockAtBoundary()public{mechanics.start(100);PokerTournamentStructure420.Hand memory a=mechanics.lock(CONTEXT,TABLE,HAND,160);PokerTournamentStructure420.Hand memory b=mechanics.lock(CONTEXT,keccak256("other table"),keccak256("other hand"),160);require(a.level==2&&a.bigBlind==b.bigBlind&&a.digest!=b.digest);}
    function testConcurrentTableHandsCanKeepDifferentBoundarySnapshots()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,159);PokerTournamentStructure420.Hand memory b=mechanics.lock(CONTEXT,keccak256("other table"),keccak256("other hand"),160);require(mechanics.handOf(HAND).bigBlind==10&&b.bigBlind==20);}
    function testBusyTableAndHandReplayRejected()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,100);fail(abi.encodeCall(mechanics.lock,(CONTEXT,TABLE,keccak256("next"),uint256(101))));fail(abi.encodeCall(mechanics.lock,(CONTEXT,keccak256("other"),HAND,uint256(101))));}
    function testClosedHandCannotReopenOrBePosted()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,100);mechanics.close(CONTEXT,TABLE,HAND);require(mechanics.active(TABLE)==0);fail(abi.encodeCall(mechanics.lock,(CONTEXT,TABLE,HAND,uint256(101))));}
    function testCloseRequiresExactContextAndTable()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,100);fail(abi.encodeCall(mechanics.close,(keccak256("wrong context"),TABLE,HAND)));fail(abi.encodeCall(mechanics.close,(CONTEXT,keccak256("wrong table"),HAND)));require(mechanics.active(TABLE)==HAND);}
    function testNextHandUsesNewLevelAfterClosingOldHand()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,100);mechanics.close(CONTEXT,TABLE,HAND);PokerTournamentStructure420.Hand memory h=mechanics.lock(CONTEXT,TABLE,keccak256("next"),160);require(h.level==2&&h.bigBlind==20);}
    function testHandCommitPreventsClockRewindAcrossTables()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,200);fail(abi.encodeCall(mechanics.lock,(CONTEXT,keccak256("other table"),keccak256("other hand"),uint256(150))));}
    function testPausedAndRecoveryClockCannotOpenHand()public{mechanics.startWithPolicy(CONTEXT,9,100,100);mechanics.pause(110,100);fail(abi.encodeCall(mechanics.lock,(CONTEXT,TABLE,HAND,uint256(111))));mechanics.observe(210,100);fail(abi.encodeCall(mechanics.lock,(CONTEXT,TABLE,HAND,uint256(211))));}
    function testFinishFreezesClockAndPreventsNewHands()public{mechanics.start(100);mechanics.finish(170,1000);require(mechanics.elapsed(1000)==70);fail(abi.encodeCall(mechanics.lock,(CONTEXT,TABLE,HAND,uint256(1000))));fail(abi.encodeCall(mechanics.start,(uint256(1001))));}
    function testHandContextRejectsEmptyIdentifiers()public{mechanics.start(100);fail(abi.encodeCall(mechanics.lock,(bytes32(0),TABLE,HAND,uint256(100))));fail(abi.encodeCall(mechanics.lock,(CONTEXT,bytes32(0),HAND,uint256(100))));fail(abi.encodeCall(mechanics.lock,(CONTEXT,TABLE,bytes32(0),uint256(100))));}
    function testClockFreezesRecoveryPolicyAtStart()public{mechanics.start(100);mechanics.pause(110,1000);fail(abi.encodeCall(mechanics.resume,(uint256(120),uint32(2000))));fail(abi.encodeCall(mechanics.observe,(uint256(120),uint32(2000))));require(mechanics.clockOf().recoveryGrace==1000);}
    function testClockRejectsScheduleSubstitution()public{mechanics.start(100);PokerTournamentStructure420.Level[] memory list=levels();require(mechanics.clockOf().scheduleHash==keccak256(abi.encode(list)));list[0].duration=120;fail(abi.encodeCall(mechanics.lockWithSchedule,(CONTEXT,TABLE,HAND,uint256(160),list)));}
    function testFinishWaitsForAllLockedHands()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,100);fail(abi.encodeCall(mechanics.finish,(uint256(101),uint32(1000))));mechanics.close(CONTEXT,TABLE,HAND);mechanics.finish(102,1000);require(mechanics.clockOf().state==PokerTournamentStructure420.State.FINISHED);}
    function testHandCannotBorrowAnotherEventClock()public{mechanics.start(100);fail(abi.encodeCall(mechanics.lock,(keccak256("another event"),TABLE,HAND,uint256(100))));}
    function testActiveTableCountCannotExceedFrozenCapacity()public{mechanics.startWithPolicy(CONTEXT,1,1000,100);mechanics.lock(CONTEXT,TABLE,HAND,100);fail(abi.encodeCall(mechanics.lock,(CONTEXT,keccak256("second table"),keccak256("second hand"),uint256(101))));mechanics.close(CONTEXT,TABLE,HAND);mechanics.lock(CONTEXT,keccak256("second table"),keccak256("second hand"),102);}
    function testInvalidFrozenClockPolicyRejected()public{fail(abi.encodeCall(mechanics.startWithPolicy,(bytes32(0),uint16(1),uint32(1000),uint256(100))));fail(abi.encodeCall(mechanics.startWithPolicy,(CONTEXT,uint16(0),uint32(1000),uint256(100))));fail(abi.encodeCall(mechanics.startWithPolicy,(CONTEXT,uint16(1),uint32(0),uint256(100))));}
    function testSnapshotSeparatesNativeHostIdentity()public{mechanics.start(100);PokerTournamentStructure420.Hand memory a=mechanics.lock(CONTEXT,TABLE,HAND,100);StructureMechanicsHarness420 other=new StructureMechanicsHarness420(levels());other.start(100);PokerTournamentStructure420.Hand memory b=other.lock(CONTEXT,TABLE,HAND,100);require(a.digest!=b.digest);}
    function testExistingHandCanCloseDuringPause()public{mechanics.start(100);mechanics.lock(CONTEXT,TABLE,HAND,100);mechanics.pause(110,1000);mechanics.close(CONTEXT,TABLE,HAND);require(mechanics.handOf(HAND).closed&&mechanics.clockOf().state==PokerTournamentStructure420.State.PAUSED);}
    function testFuzzPauseDurationDoesNotAdvancePlayingClock(uint32 before_,uint32 duration,uint32 after_)public{uint256 beforeTime=uint256(before_%10000);uint256 pauseTime=uint256(duration%99);uint256 afterTime=uint256(after_%10000);mechanics.startWithPolicy(CONTEXT,9,100,100);mechanics.pause(100+beforeTime,100);mechanics.resume(100+beforeTime+pauseTime,100);require(mechanics.elapsed(100+beforeTime+pauseTime+afterTime)==beforeTime+afterTime);}
    function testFuzzDirectLevelSelectionMatchesIndependentBoundaries(uint64 t)public view{PokerTournamentStructure420.Position memory p=mechanics.at(t);require(p.level==(t<60?1:t<180?2:3)&&p.finalLevel==(t>=180));}
}
contract TournamentStructureBlinds420Test is StructureTestBase420 {
    function hand()private pure returns(PokerTournamentStructure420.Hand memory h){h.digest=keccak256("unit arithmetic snapshot");h.smallBlind=5;h.bigBlind=10;h.level=1;}
    function testHeadsUpButtonPostsSmallBlind()public view{uint256[9] memory s;s[0]=100;s[4]=100;(uint8 sb,uint8 bb,uint256[9] memory r,,uint256 pot)=mechanics.post(hand(),17,0,s);require(sb==0&&bb==4&&r[0]==95&&r[4]==90&&pot==15);}
    function testMultiwayBlindPositionsWrapOccupiedSeats()public view{uint256[9] memory s;s[0]=100;s[3]=100;s[8]=100;(uint8 sb,uint8 bb,,,uint256 pot)=mechanics.post(hand(),265,8,s);require(sb==0&&bb==3&&pot==15);}
    function testShortStackBlindsAreCappedWithoutChangingNominalLevel()public view{uint256[9] memory s;s[0]=2;s[4]=3;PokerTournamentStructure420.Hand memory h=hand();(,,uint256[9] memory r,uint256[9] memory posted,uint256 pot)=mechanics.post(h,17,0,s);require(r[0]==0&&r[4]==0&&posted[0]==2&&posted[4]==3&&pot==5&&h.bigBlind==10);}
    function testNonparticipantsAreNeverDebited()public view{uint256[9] memory s;s[0]=100;s[4]=100;s[2]=77;(,,uint256[9] memory r,uint256[9] memory posted,)=mechanics.post(hand(),17,0,s);require(r[2]==77&&posted[2]==0);}
    function testEmptyOrOversizedMaskRejected()public{uint256[9] memory s;s[0]=100;s[4]=100;fail(abi.encodeCall(mechanics.post,(hand(),uint16(0),uint8(0),s)));fail(abi.encodeCall(mechanics.post,(hand(),uint16(529),uint8(0),s)));}
    function testMissingButtonOrSingleParticipantRejected()public{uint256[9] memory s;s[0]=100;s[4]=100;fail(abi.encodeCall(mechanics.post,(hand(),uint16(17),uint8(2),s)));fail(abi.encodeCall(mechanics.post,(hand(),uint16(1),uint8(0),s)));}
    function testZeroStackParticipantCannotBeSilentlySkipped()public{uint256[9] memory s;s[0]=100;fail(abi.encodeCall(mechanics.post,(hand(),uint16(17),uint8(0),s)));}
    function testUncommittedOrClosedHandCannotPost()public{uint256[9] memory s;s[0]=100;s[4]=100;PokerTournamentStructure420.Hand memory h=hand();h.digest=0;fail(abi.encodeCall(mechanics.post,(h,uint16(17),uint8(0),s)));h=hand();h.closed=true;fail(abi.encodeCall(mechanics.post,(h,uint16(17),uint8(0),s)));}
    function testFuzzBlindPostingConservesEverySeat(uint128 a,uint128 b)public view{uint256[9] memory s;s[0]=uint256(a)+1;s[4]=uint256(b)+1;(,,uint256[9] memory r,uint256[9] memory p,uint256 pot)=mechanics.post(hand(),17,0,s);for(uint8 i;i<9;i++)require(r[i]+p[i]==s[i]);require(pot==p[0]+p[4]&&p[0]<=5&&p[4]<=10);}
}
contract TournamentStructureBook420Test is EntryFixture420 {
    PokerTournamentStructureBook420 private book;bytes32 private constant STRUCTURE=keccak256("structure");bytes32 private reserveGrant;
    event StructureIdentity(address book,bytes32 runtimeHash,bytes32 structureDigest,bytes32 boundManifest,address escrow,uint256 reservedChips,uint256 assetLiability,uint256 prizeBalance,uint256 heldFees);
    function setUp()public override{super.setUp();book=new PokerTournamentStructureBook420(address(policies),address(escrow));grant(address(this),book.CREATE(),book.scope(STRUCTURE,0));grant(address(this),book.APPROVE(),book.scope(STRUCTURE,0));grant(address(this),book.PUBLISH(),book.scope(STRUCTURE,0));grant(address(this),book.RETIRE(),book.scope(STRUCTURE,0));grant(address(this),book.BIND_POLICY(),book.scope(POLICY,1));grant(address(this),book.BIND_EVENT(),book.scope(EVENT,2));reserveGrant=grant(address(alice),book.RESERVE(),book.scope(EVENT,2));grant(address(bob),book.RESERVE(),book.scope(EVENT,2));}
    function levels()private pure returns(PokerTournamentStructure420.Level[] memory l){l=new PokerTournamentStructure420.Level[](3);l[0]=PokerTournamentStructure420.Level(5,10,60);l[1]=PokerTournamentStructure420.Level(10,20,120);l[2]=PokerTournamentStructure420.Level(20,40,180);}
    function _structure(uint128 stack)private{book.register(STRUCTURE,OP,stack,levels());book.approve(STRUCTURE);book.publish(STRUCTURE);}
    function _event(PokerTournamentPolicy420.Config memory c)private{_structure(c.startingStack);c.blindSchedule=book.structureOf(STRUCTURE).digest;_publish(c);book.bindPolicy(POLICY,STRUCTURE);book.bindEvent(EVENT);vm.warp(200);}
    function _reserve(EntryActor420 actor,uint64 receipt)private{actor.invoke(address(book),abi.encodeCall(book.reserve,(EVENT,receipt,book.boundManifest(EVENT))));}
    function testLegitimateFundedReceiptReservesExactStartingStack()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);require(book.reservedChips(EVENT)==1000&&book.reservedPlayers(EVENT)==1&&asset.balanceOf(address(escrow))==103&&book.acceptsFunds()==false);emit StructureIdentity(address(book),address(book).codehash,book.structureOf(STRUCTURE).digest,book.boundManifest(EVENT),address(escrow),book.reservedChips(EVENT),escrow.totalLiability(),escrow.heldPrizes(),escrow.heldFees());_invariant();}
    function testEveryPlayerGetsSameStartingStack()public{_event(config());_buy(alice,A,AC,1);_buy(bob,B,BC,1);_reserve(alice,1);_reserve(bob,2);require(book.reservationOf(EVENT,1).chips==1000&&book.reservationOf(EVENT,2).chips==1000&&book.reservedChips(EVENT)==2000);}
    function testStartingStackIsIndependentOfTokenPrice()public{PokerTournamentPolicy420.Config memory c=config();c.startingStack=type(uint128).max;_event(c);_buy(alice,A,AC,1);_reserve(alice,1);require(book.reservedChips(EVENT)==type(uint128).max&&escrow.totalLiability()==103);}
    function testFreeSponsoredEntryHasSameStackAndNoFee()public{PokerTournamentPolicy420.Config memory c=config();c.buyIn=0;c.sponsoredPrize=500;_event(c);_buy(alice,A,AC,1);_reserve(alice,1);require(book.reservedChips(EVENT)==1000&&escrow.heldFees()==0&&escrow.heldPrizes()==500);}
    function testDuplicateReceiptCannotMintAnotherStack()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);_fail(alice,address(book),abi.encodeCall(book.reserve,(EVENT,uint64(1),book.boundManifest(EVENT))));require(book.reservedChips(EVENT)==1000);}
    function testUnpaidReceiptCannotCreateStack()public{_event(config());_fail(alice,address(book),abi.encodeCall(book.reserve,(EVENT,uint64(1),book.boundManifest(EVENT))));require(book.reservedChips(EVENT)==0);}
    function testOtherWalletCannotReservePaidStack()public{_event(config());_buy(alice,A,AC,1);_fail(bob,address(book),abi.encodeCall(book.reserve,(EVENT,uint64(1),book.boundManifest(EVENT))));}
    function testWrongManifestAndEventCannotReuseReceipt()public{_event(config());_buy(alice,A,AC,1);_fail(alice,address(book),abi.encodeCall(book.reserve,(EVENT,uint64(1),bytes32(0))));_fail(alice,address(book),abi.encodeCall(book.reserve,(keccak256("wrong event"),uint64(1),book.boundManifest(EVENT))));}
    function testRefundedStackProjectionBecomesInvalidImmediately()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);alice.invoke(address(escrow),abi.encodeCall(escrow.unregister,(EVENT,uint64(1),uint64(1))));require(!book.reservationLive(EVENT,1));book.syncReservation(EVENT,1);require(book.reservedChips(EVENT)==0&&book.reservedPlayers(EVENT)==0&&escrow.credit(address(alice))==103);}
    function testPermissionlessCleanupCannotRemoveLiveReservation()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);_reject(address(book),abi.encodeCall(book.syncReservation,(EVENT,uint64(1))));require(book.reservedChips(EVENT)==1000);}
    function testStaleCapacityCanBeCleanedAndReusedAtomically()public{PokerTournamentPolicy420.Config memory c=config();c.maxPlayers=2;_event(c);_buy(alice,A,AC,1);_buy(bob,B,BC,1);_reserve(alice,1);_reserve(bob,2);alice.invoke(address(escrow),abi.encodeCall(escrow.unregister,(EVENT,uint64(1),uint64(1))));bytes32 subject=keccak256("third player");bytes32 credential=keccak256("third credential");_identity(outsider,subject,credential,keccak256("third person"));grant(address(outsider),escrow.ENTER(),escrow.scope(EVENT));grant(address(outsider),book.RESERVE(),book.scope(EVENT,2));_buy(outsider,subject,credential,1);uint64[] memory stale=new uint64[](1);stale[0]=1;outsider.invoke(address(book),abi.encodeCall(book.reserveAfterCleanup,(EVENT,uint64(3),book.boundManifest(EVENT),stale)));require(book.reservedPlayers(EVENT)==2&&book.reservedChips(EVENT)==2000&&book.reservationOf(EVENT,1).released&&book.reservationLive(EVENT,3));_invariant();}
    function testAtomicCleanupCannotDisplaceAnotherLivePlayer()public{_event(config());_buy(alice,A,AC,1);_buy(bob,B,BC,1);_reserve(alice,1);uint64[] memory stale=new uint64[](1);stale[0]=1;_fail(bob,address(book),abi.encodeCall(book.reserveAfterCleanup,(EVENT,uint64(2),book.boundManifest(EVENT),stale)));require(book.reservedChips(EVENT)==1000&&book.reservationLive(EVENT,1));}
    function testCleanupBatchHasFiniteGasBound()public{_event(config());_buy(alice,A,AC,1);uint64[] memory stale=new uint64[](257);_fail(alice,address(book),abi.encodeCall(book.reserveAfterCleanup,(EVENT,uint64(1),book.boundManifest(EVENT),stale)));require(book.reservedChips(EVENT)==0);}
    function testRefundAndRepurchaseKeepsOneStackAndPersistentNonce()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);alice.invoke(address(escrow),abi.encodeCall(escrow.unregister,(EVENT,uint64(1),uint64(1))));_buy(alice,A,AC,2);_reserve(alice,2);require(book.reservedChips(EVENT)==1000&&book.reservedPlayers(EVENT)==1&&book.reservationOf(EVENT,1).released&&book.reservationOf(EVENT,2).nonce==2);}
    function testCancellationReleasesChipProjectionWithoutMovingRefundAssets()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);vm.warp(2200);book.syncReservation(EVENT,1);require(book.reservedChips(EVENT)==0&&escrow.totalLiability()==103&&asset.balanceOf(address(escrow))==103);escrow.refundCancelled(EVENT,1);alice.invoke(address(escrow),abi.encodeCall(escrow.withdraw,()));require(asset.balanceOf(address(alice))==10000);}
    function testTechnicalTimeoutRejectsNewStackReservation()public{_event(config());_buy(alice,A,AC,1);_buy(bob,B,BC,1);vm.warp(1000);_fail(alice,address(book),abi.encodeCall(book.reserve,(EVENT,uint64(1),book.boundManifest(EVENT))));require(book.reservedChips(EVENT)==0);}
    function testExistingPaymentKeepsLongerTechnicalReadinessWindow()public{PokerTournamentPolicy420.Config memory c=config();c.technicalGrace=5000;_event(c);_buy(alice,A,AC,1);_buy(bob,B,BC,1);vm.warp(2201);require(!policies.usableForNewEvent(POLICY));_reserve(alice,1);require(book.reservationLive(EVENT,1)&&escrow.totalLiability()==206);}
    function testExpiredReservationViewRejectsWithoutKeeperTick()public{_event(config());_buy(alice,A,AC,1);_buy(bob,B,BC,1);_reserve(alice,1);vm.warp(999);require(book.reservationLive(EVENT,1));vm.warp(1000);require(!book.reservationLive(EVENT,1));book.syncReservation(EVENT,1);require(book.reservedChips(EVENT)==0);}
    function testUnderfilledReservationViewExpiresWithoutTick()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);vm.warp(2199);require(book.reservationLive(EVENT,1));vm.warp(2200);require(!book.reservationLive(EVENT,1));}
    function testReleaseAndReceiptReplayRejected()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);alice.invoke(address(escrow),abi.encodeCall(escrow.unregister,(EVENT,uint64(1),uint64(1))));book.syncReservation(EVENT,1);_reject(address(book),abi.encodeCall(book.syncReservation,(EVENT,uint64(1))));_fail(alice,address(book),abi.encodeCall(book.reserve,(EVENT,uint64(1),book.boundManifest(EVENT))));}
    function testNoCashoutOrLiveHandActivationApi()public{_event(config());_buy(alice,A,AC,1);_reserve(alice,1);_reject(address(book),abi.encodeWithSignature("cashout(bytes32)",EVENT));_reject(address(book),abi.encodeWithSignature("start(bytes32)",EVENT));_reject(address(book),abi.encodeWithSignature("setStack(bytes32,bytes32,uint256)",EVENT,A,2000));require(!book.liveHandIntegrationEnabled()&&escrow.totalLiability()==103);}
