    function testRevokedReservationAuthorityCannotTrapFinancialRefund()public{_event(config());_buy(alice,A,AC,1);caps.revokeGrant(reserveGrant);_fail(alice,address(book),abi.encodeCall(book.reserve,(EVENT,uint64(1),book.boundManifest(EVENT))));alice.invoke(address(escrow),abi.encodeCall(escrow.unregister,(EVENT,uint64(1),uint64(1))));alice.invoke(address(escrow),abi.encodeCall(escrow.withdraw,()));require(asset.balanceOf(address(alice))==10000);}
