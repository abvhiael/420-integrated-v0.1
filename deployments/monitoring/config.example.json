{
  "node": "validator-01",
  "stateDir": "/var/lib/stake-monitor",
  "listen": "0.0.0.0:9545",
  "intervalSeconds": 15,
  "freshSeconds": 45,
  "maxAttempts": 6,
  "baseBackoffSeconds": 5,
  "maxBackoffSeconds": 300,
  "allowExternalDelivery": false,
  "destinations": [{"id":"operator-local-simulation","url":"http://127.0.0.1:9999/alarms"}],
  "trust": "/input/consensus/trust.json",
  "trustSHA256": "REPLACE_WITH_INDEPENDENTLY_APPROVED_SHA256_BEFORE_INITIALIZATION",
  "consensusDir": "/input/consensus/settlement",
  "engineURL": "http://node420:8551",
  "engineJWTFile": "/run/secrets/engine-jwt",
  "indexerStore": "/input/indexer/index.json",
  "accountingReport": "/input/accounting/report.json",
  "canarySnapshot": "/input/canary/snapshot.json",
  "signerHealth": "/input/health/signer/signer.json",
  "validatorHealth": "/input/health/validator/validator.json",
  "settlementHealth": "/input/health/settlement/settlement.json",
  "baselinePolicy": "/etc/stake-monitor/public-monitoring-policy.json"
}
