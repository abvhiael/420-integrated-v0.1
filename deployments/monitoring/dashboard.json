{
  "uid": "stake-audit-9-5",
  "title": "Stake operational recovery and alarm delivery",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "stake",
    "operational-projection"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Consensus certification and finality",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stake_current_slot"
        },
        {
          "refId": "B",
          "expr": "stake_head_slot"
        },
        {
          "refId": "C",
          "expr": "stake_finalized_slot"
        },
        {
          "refId": "D",
          "expr": "stake_uncertified_slots"
        },
        {
          "refId": "E",
          "expr": "stake_finality_lag_slots"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 2,
      "title": "Validator eligibility and participation",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stake_active_seats"
        },
        {
          "refId": "B",
          "expr": "stake_committee_seats"
        },
        {
          "refId": "C",
          "expr": "stake_eligible_validators"
        },
        {
          "refId": "D",
          "expr": "stake_qc_signers"
        },
        {
          "refId": "E",
          "expr": "stake_qc_quorum"
        },
        {
          "refId": "F",
          "expr": "stake_attestation_participation_pct"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "id": 3,
      "title": "Execution and sequencing",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stake_execution_block"
