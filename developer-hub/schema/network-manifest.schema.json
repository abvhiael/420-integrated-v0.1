{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://420integrated.org/schemas/developer-hub/network-manifest-v1.json",
  "title": "420 Developer Hub Network Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "nativeCurrency",
    "rpc",
    "services",
    "contracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment", "chainId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "string",
          "enum": ["local", "devnet", "testnet", "mainnet"]
        },
        "chainId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "nativeCurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "decimals"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "const": "420" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "rpc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http"],
      "properties": {
        "http": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "websocket": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explorer": { "type": "string", "format": "uri" },
        "indexer": { "type": "string", "format": "uri" },
        "verify": { "type": "string", "format": "uri" },
        "status": { "type": "string", "format": "uri" },
        "faucet": { "type": "string", "format": "uri" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "source"],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "source": {
            "type": "string",
            "enum": ["genesis", "registry", "governance", "deployment-manifest"]
          },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
