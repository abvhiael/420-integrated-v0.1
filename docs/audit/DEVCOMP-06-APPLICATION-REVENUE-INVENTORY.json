  "routes": [
    {
      "application": "420Exchange",
      "route": "Retained execution fee",
      "classification": "eligible",
      "trace": "Atomic execution settles actual output, checks user minimum after the fee, and sends only the retained fee to the five-way router. The router forwards the declared developer share using the trade reference and canonical policy. A revert rolls back the trade and fee. Launch remains gated under Decision 2.",
      "sources": [
        "contracts/src/exchange/ExchangeAtomicRouter420.sol",
        "contracts/src/exchange/ExchangeFeeRouter420.sol",
        "contracts/src/exchange/ExchangeFeePolicy420.sol",
        "contracts/test/ExchangeFeeSettlement420.t.sol",
        "420-indexer/scripts/qualify-compensation-receipts.mjs"
      ],
      "vaultCallers": [
        "contracts/src/exchange/ExchangeFeeRouter420.sol"
      ]
    },
    {
      "application": "420Bet",
      "route": "Daily contest",
      "classification": "policy-exception",
      "trace": "Entry funding remains escrowed until dispute finality. Canceled entries refund, prize credits remain payable, and the finalized pool reserves a separate three-percent charge. The vault forwards the per-pool charge and emits incremental basis while preserving cumulative rounding.",
      "sources": [
        "contracts/src/bet/fantasy/FantasyContestEngine420.sol",
        "contracts/src/revenue/DevelopmentCompensationVault420.sol",
        ".github/workflows/420bet-fantasy-approved-level2.yml"
      ],
      "vaultCallers": [
        "contracts/src/bet/fantasy/FantasyContestEngine420.sol"
      ]
    },
    {
      "application": "420Bet",
      "route": "Peer and house-backed formats",
      "classification": "policy-exception",
      "trace": "Peer pools reserve fees on qualified entries. House cards settle per entry, reserve prizes and refunds, and queue the cumulative fee when the bankroll becomes releasable. The vault forwards the per-pool charge and emits incremental basis while preserving cumulative rounding.",
      "sources": [
        "contracts/src/bet/fantasy/FantasyFormatEscrow420.sol",
        "contracts/src/revenue/DevelopmentCompensationVault420.sol",
        ".github/workflows/420bet-fantasy-approved-level2.yml"
      ],
      "vaultCallers": [
        "contracts/src/bet/fantasy/FantasyFormatEscrow420.sol"
      ]
    },
    {
      "application": "420Bet",
      "route": "Season escrow",
      "classification": "policy-exception",
      "trace": "Entry fees remain escrowed through weekly disputes and final ranking. Cancellation returns refundable balances. Final settlement queues the pool charge. The vault forwards the per-pool charge and emits incremental basis while preserving cumulative rounding.",
      "sources": [
        "contracts/src/bet/fantasy/FantasySeasonEscrow420.sol",
        "contracts/src/revenue/DevelopmentCompensationVault420.sol",
        ".github/workflows/420bet-fantasy-approved-level2.yml"
      ],
      "vaultCallers": [
        "contracts/src/bet/fantasy/FantasySeasonEscrow420.sol"
      ]
    },
    {
      "application": "420Bet",
      "route": "Casino-wide retained profit",
      "classification": "review-required",
      "trace": "Reconcile bankroll, poker, sportsbook, prediction markets and shared pools against finalized eligible net profit. Verify existing Fantasy charges are counted once before enabling the waterfall.",
      "sources": [
        "contracts/config/420bet-capitalization-profit-waterfall-v1.json"
      ]
    },
    {
      "application": "420 Pay",
      "route": "Payment and refund settlement",
      "classification": "excluded",
      "trace": "The current payment router requires zero protocol fee. Merchant settlement and refundable funds do not accrue compensation on this path.",
      "sources": [
        "contracts/src/pay/PaymentRouter420.sol",
        "contracts/src/pay/RefundManager420.sol"
      ]
    },
    {
      "application": "420 Swap",
      "route": "Canonical pool LP fee",
      "classification": "excluded",
      "trace": "The constant-product fee is retained in the pool reserves and belongs to liquidity accounting. The separate Exchange execution fee has its own route.",
      "sources": [
        "contracts/src/swap/CanonicalConstantProductPool420.sol",
        "contracts/src/exchange/ExchangeAtomicRouter420.sol"
      ]
    },
    {
      "application": "420 Token",
      "route": "Token creation",
