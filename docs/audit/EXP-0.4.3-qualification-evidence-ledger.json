{
  "schema": "420explorer-exp-0.4.3-qualification-evidence-ledger-v1",
  "milestone": "EXP-0.4.3",
  "title": "420Explorer exact-head qualification evidence provenance ledger",
  "status": "qualified_repository_scope_initial_head_recorded",
  "baseline": {
    "pr": 376,
    "base_sha": "304cb61286c94f72d0b05e32e5f713b9d68bc450",
    "pre_0_4_3_head": "0e0b6a35557e9e90a7b697903c8abeebcdfedebd"
  },
  "qualification_layers": {
    "source_qualified": "Repository source/static checks passed on the recorded exact head.",
    "integration_qualified": "Cross-component repository/integration checks passed on the recorded exact head.",
    "runtime_qualified": "A production-equivalent runtime composition was executed and evidenced on the recorded exact head/environment.",
    "deployment_qualified": "The intended deployed service identity/configuration was verified and evidenced.",
    "live_network_qualified": "Approved live/testnet endpoint and representative witnesses were verified.",
    "genesis_qualified": "All applicable acceptance criteria and blockers are closed on the exact release candidate."
  },
  "promotion_rules": [
    "source_qualified does not imply runtime_qualified, deployment_qualified, live_network_qualified, or genesis_qualified",
    "integration_qualified does not imply deployment or live-network qualification",
    "artifact existence never substitutes for successful verifier/job conclusions",
    "historical exact-head evidence remains evidence for its recorded scope but current promotion requires current authoritative ledgers and applicable later gates",
    "Genesis qualification requires an exact release-candidate closeout and cannot be inferred from any single prior event"
  ],
  "qualification_profiles": {
    "EXP-QP-001": {
      "name": "Explorer/Indexer exact-head repository qualification",
      "commands": [
        "go test ./indexer/...",
        "go vet ./indexer/...",
        "npm test (420-indexer)",
        "go test ./explorer/...",
        "go vet ./explorer/...",
        "readiness/config validation",
        "retained EXP verifier chain",
        "pinned-tree EXP-0.1.1 inventory"
      ],
      "layers": [
        "source_qualified",
        "integration_qualified"
      ]
    },
    "EXP-QP-002": {
      "name": "Documentation qualification",
      "commands": [
        "pip install -r requirements-docs.txt",
        "python scripts/qualify-documentation.py"
      ],
      "layers": [
        "source_qualified"
      ]
    },
    "EXP-QP-003": {
      "name": "Repository qualification",
      "commands": [
        "go test ./...",
        "core binary builds",
        "production dependency checks",
        "pinned Geth Engine smoke",
        "fault matrix",
        "120-slot soak"
      ],
      "layers": [
        "source_qualified",
        "integration_qualified"
      ]
    }
  },
