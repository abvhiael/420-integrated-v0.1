  "retention_semantics": {
    "repository_records": "Durable through Git history and sufficient to preserve the claimed evidence meaning, exact SHA, command/workflow identity and promotion limits.",
    "action_artifacts": "Ephemeral external evidence. Artifact IDs/digests are retained here, but continued GitHub artifact availability is not assumed.",
    "action_run_job_ids": "External provenance pointers; useful for audit while retained by GitHub but not the sole source of qualification meaning.",
    "artifact_digest": "Integrity witness when historically recorded. A missing historical digest must remain explicitly unavailable and must never be reconstructed or guessed.",
    "reproducibility": "Means the repository retains enough source, workflow/verifier identity, exact-head provenance and replay instructions to rerun the applicable qualification class; it does not mean an expired historical artifact can be byte-for-byte recovered."
  },
  "policies": [
    "No qualification claim may depend solely on continued availability of a GitHub Actions artifact.",
    "Every retained qualification event must name an exact commit and at least one successful run provenance pointer.",
    "Every current EXP-0.4 closeout from 0.4.3 onward must retain an artifact digest.",
    "Historical missing digests are fail-closed: preserve the missing state and use replay rather than fabrication.",
    "Replay of repository qualification must use the workflow/verifier definitions from the target commit or a documented current-equivalent verifier chain; results qualify the replayed head, not the historical head.",
    "Live/deployment evidence requires the original environment inputs or a new approved environment-bound execution; repository replay cannot substitute for it.",
    "Final Genesis evidence must eventually be copied into repository-resident closeout records under EXP-8 in addition to external CI artifacts."
  ],
