    "source": "canonical execution JSON-RPC eth_getTransactionReceipt.effectiveGasPrice",
    "formula": "actualFeeWei = gasUsed * effectiveGasPriceWei",
    "representation": "base-10 integer strings for fee quantities; gasUsed remains uint64",
    "canonical_authority": false,
    "rationale": "420Indexer and 420Explorer are derived read infrastructure and do not become settlement authority."
  },
