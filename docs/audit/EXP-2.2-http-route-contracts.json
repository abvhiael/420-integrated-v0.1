    "/v1/services",
    "/v1/services/{service}",
    "/v1/services/{service}/versions/{version}",
    "/v1/assets/activity",
    "/v1/consensus"
  ],
  "tests_required": [
    "capabilities endpoint exactly advertises the qualified route set",
    "network status representative and wrong-chain/stale/degraded negative routes",
    "block list/detail/trace representative serialization",
    "block-list invalid and >250 limit rejection",
    "transaction/receipt representative serialization including EXP-2.1 fee fields",
    "service-version representative serialization",
    "unknown /v1 route JSON 404",
    "unsupported API method cannot fall through to SPA",
