  "objective": "Qualify the 420Explorer HTTP/API server contract for core status, block, transaction/receipt, and ProtocolRegistry service/version routes, including complete route discovery, bounded pagination, provenance headers, representative response serialization, and fail-closed invalid/unsupported API behavior.",
  "implementation_boundary": {
    "owns": [
      "Explorer HTTP route registration and capability discovery contract",
      "network status/readiness HTTP presentation",
      "block list/detail/trace HTTP routing",
      "transaction and receipt HTTP routing",
      "ProtocolRegistry service/version HTTP routing",
      "HTTP pagination-input validation",
      "API-vs-SPA routing isolation and JSON failure behavior"
    ],
    "does_not_own": [
      "canonical chain authority",
      "live target-network deployment",
      "Registry runtime/code-hash qualification",
      "frontend workflow qualification",
      "post-Genesis application-specific interpretation"
    ]
  },
  "defects_remediated": [
    "capabilities endpoint omitted registered block-detail and service/service-version routes",
    "block-list HTTP limit had no explicit upper bound",
    "unknown or unsupported /v1 requests could fall through to the SPA catch-all instead of failing as JSON API requests"
  ],
  "acceptance_criteria": [
    "AC-1 core Explorer API routes serialize representative indexed data correctly",
    "AC-5 Explorer presentation/API semantics expose provenance and fail closed on invalid requests",
    "AC-7 malformed or unsupported API requests do not produce misleading successful web content",
    "AC-8 operational/API boundaries remain explicit and non-authoritative"
  ],
  "route_contract": [
    "/v1/health",
