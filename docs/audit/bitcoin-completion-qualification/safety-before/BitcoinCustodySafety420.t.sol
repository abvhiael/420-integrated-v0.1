pragma solidity ^0.8.24;
import "./BitcoinCustodyCompletion420.t.sol";
contract BitcoinCustodySafety420Test is BitcoinCustodyFixture420 {
 function setUp() public {setupCustody(true);}
 function testGlobalPauseSafetyAndAssetHealthBlockSigning() public {bytes32 id=authorize(100,0);f.env.pause().setPaused(true);(bool ok,)=address(custody).staticcall(abi.encodeCall(custody.signingAuthorization,(requestId,id)));require(!ok);f.env.pause().setPaused(false);f.env.safety().setAllowed(false);(ok,)=address(custody).staticcall(abi.encodeCall(custody.signingAuthorization,(requestId,id)));require(!ok);f.env.safety().setAllowed(true);f.env.health().setAsset(ASSET_ID,false);(ok,)=address(custody).staticcall(abi.encodeCall(custody.signingAuthorization,(requestId,id)));require(!ok);custody.setActive(false);}
 function testInboundOnlyCustodyQualificationCannotAuthorizeWithdrawals() public {custody.setActive(false);bytes32 previous=q.currentApproval(address(custody));BridgeVerifierRegistry420.Registration memory r=abi.decode(q.registration(previous),(BridgeVerifierRegistry420.Registration));r.directions=1;q.record(r,previous,true);(bool ok,)=address(custody).call(abi.encodeCall(custody.setActive,(true)));require(!ok);}
 function testUnqualifiedConsumerCannotActivate() public {custody.setActive(false);q.revoke(q.currentApproval(address(custody)),keccak256("unqualified custody"));(bool ok,)=address(custody).call(abi.encodeCall(custody.setActive,(true)));require(!ok);}
 function testNonconflictingReplacementFundingIsRejected() public {bytes32 first=authorize(100,0);bytes memory raw=transaction(200,false);raw[5]^=0x01;IBitcoinCustody420.FundingInput[] memory list=funding();list[0].txid=bytes32(BridgeWire420.readBE(raw,5,32));(bool ok,)=address(custody).call(abi.encodeCall(custody.authorizeSigning,(requestId,raw,list,hex"01",first)));require(!ok);require(custody.signingAuthorization(requestId,first));}
 function testNativeVerifierRotationRequiresFreshCustodyApprovalAndBacking() public {bytes32 first=authorize(100,0);BitcoinFinalityVerifier420 next=new BitcoinFinalityVerifier420(headerChain,custodyScript(),ROUTE_ID,1,address(f.router));btc.setVerifier(address(next));BridgeQualificationFixture420.approveRoute(f.env,f.routes,ROUTE_ID,address(btc),address(next),bytes4(keccak256("verifier()")),abi.encodeWithSignature("gatewayScriptHash()"),abi.encodeWithSignature("depositDomain()"),true);(bool ok,)=address(custody).staticcall(abi.encodeCall(custody.signingAuthorization,(requestId,first)));require(!ok);custody.setActive(false);qualifyCustody();custody.setActive(true);require(!custody.signingAuthorization(requestId,first));bytes32 second=authorize(200,first);require(second!=first&&custody.signingAuthorization(requestId,second));require(custody.reservedInputs(keccak256(abi.encode(prev,uint32(0))))==requestId);}
}
