{
  "schema_version": 1,
  "workflow": ".github/workflows/docs-qualify.yml",
  "runner": "scripts/qualify-documentation.py",
  "ci_command": "python scripts/qualify-documentation.py",
  "required_runner_stages": [
    "front-matter",
    "version-metadata",
    "version-registry",
    "internal-links",
    "troubleshooting-ids",
    "orphan-navigation",
    "required-doc-coverage",
    "generated-reference-integration",
    "publication-safety",
    "workflow-contract",
    "ci-self-tests",
    "generated-reference-freshness",
    "strict-mkdocs-build",
    "search-navigation"
  ],
  "required_pull_request_triggers": [
    "docs/**",
    "mkdocs.yml",
    "requirements-docs.txt",
    "README.md",
    "scripts/qualify-documentation.py",
    "scripts/validate-doc-frontmatter.py",
    "scripts/validate-doc-version-metadata.py",
    "scripts/validate-doc-version-registry.py",
    "scripts/validate-doc-links.py",
    "scripts/validate-troubleshooting-ids.py",
    "scripts/validate-doc-orphans.py",
    "scripts/validate-required-docs.py",
    "scripts/validate-generated-reference-integration.py",
    "scripts/validate-doc-publication-safety.py",
    "scripts/validate-doc-workflow.py",
    "scripts/selftest-documentation-ci.py",
    "scripts/qualify-docs.py",
    "scripts/generate-reference-docs.py",
    "scripts/qualify-generated-reference.py",
    "scripts/reference_*_renderer.py",
    "contracts/src/**",
    "420-rpc/src/**",
    "420-indexer/src/**",
    "packages/420-sdk/**",
    "packages/420-cli/**",
    "developer-hub/manifests/**",
    "developer-hub/schema/network-manifest.schema.json",
    "developer-hub/catalogue/**",
    "developer-hub/deployment/**",
    "developer-hub/release/**",
    "developer-hub/src/network-discovery.mjs",
    "developer-hub/src/contract-catalogue.mjs",
    "developer-hub/src/deployment-control.mjs",
    "developer-hub/src/verification-control.mjs",
    ".github/workflows/docs-qualify.yml",
    ".github/workflows/docs-pages.yml"
  ],
  "required_push_triggers": [
    "docs/**",
    "mkdocs.yml",
    "requirements-docs.txt",
    "README.md",
    "scripts/qualify-documentation.py",
    "scripts/validate-doc-frontmatter.py",
    "scripts/validate-doc-version-metadata.py",
    "scripts/validate-doc-version-registry.py",
    "scripts/validate-doc-links.py",
    "scripts/validate-troubleshooting-ids.py",
    "scripts/validate-doc-orphans.py",
    "scripts/validate-required-docs.py",
    "scripts/validate-generated-reference-integration.py",
    "scripts/validate-doc-publication-safety.py",
    "scripts/validate-doc-workflow.py",
    "scripts/selftest-documentation-ci.py",
    "scripts/qualify-docs.py",
    "scripts/generate-reference-docs.py",
    "scripts/qualify-generated-reference.py",
    "scripts/reference_*_renderer.py",
    "contracts/src/**",
    "420-rpc/src/**",
    "420-indexer/src/**",
    "packages/420-sdk/**",
    "packages/420-cli/**",
    "developer-hub/manifests/**",
    "developer-hub/schema/network-manifest.schema.json",
    "developer-hub/catalogue/**",
    "developer-hub/deployment/**",
    "developer-hub/release/**",
    "developer-hub/src/network-discovery.mjs",
    "developer-hub/src/contract-catalogue.mjs",
    "developer-hub/src/deployment-control.mjs",
    "developer-hub/src/verification-control.mjs",
    ".github/workflows/docs-qualify.yml",
    ".github/workflows/docs-pages.yml"
  ],
  "required_push_branch": "main",
  "required_concurrency": {
    "group_contains": "github.workflow",
    "cancel_in_progress": true
  }
}
