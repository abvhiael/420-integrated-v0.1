{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://420integrated.example/schemas/storage/v1/storage420.schema.json",
  "title": "420 Storage Developer API v1",
  "type": "object",
  "$defs": {
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "manifest_id", "shard_index", "shard_root", "size_bytes", "commitment_id"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "manifest_id": {"type": "string", "minLength": 1},
        "shard_index": {"type": "integer", "minimum": 0},
        "shard_root": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "commitment_id": {"type": "string", "minLength": 1}
      }
    },
    "readAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["public", "private"]},
        "subject": {"type": "string"},
        "session_id": {"type": "string"},
        "capability": {"type": "string"}
      }
    },
    "retrieveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "object", "access"],
      "properties": {
        "version": {"const": "v1"},
        "object": {"$ref": "#/$defs/objectRef"},
        "access": {"$ref": "#/$defs/readAccess"}
      }
    },
    "uploadPreconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agreement_id", "capacity_reservation_id", "commitment_id"],
      "properties": {
        "agreement_id": {"type": "string", "minLength": 1},
        "capacity_reservation_id": {"type": "string", "minLength": 1},
        "commitment_id": {"type": "string", "minLength": 1}
      }
    },
    "uploadPrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "object", "idempotency_key", "preconditions"],
      "properties": {
        "version": {"const": "v1"},
        "object": {"$ref": "#/$defs/objectRef"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "preconditions": {"$ref": "#/$defs/uploadPreconditions"}
      }
    },
    "discoveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "capabilities", "include_degraded"],
      "properties": {
        "version": {"const": "v1"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["store", "repair", "cache", "gateway", "relay"]}
        },
        "include_degraded": {"type": "boolean"},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "resourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "node_id", "service_id", "capability", "priority", "state", "health", "authoritative"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1},
        "service_id": {"type": "string", "minLength": 1},
        "capability": {"enum": ["store", "repair", "cache", "gateway", "relay"]},
        "priority": {"type": "integer", "minimum": 0},
        "endpoint": {"type": "string"},
        "state": {"enum": ["registered", "starting", "running", "degraded", "stopped", "failed"]},
        "health": {"enum": ["healthy", "degraded", "pending", "stopped", "failed"]},
        "authoritative": {"const": false}
      }
    },
    "discoveryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "authoritative", "resources"],
      "properties": {
        "version": {"const": "v1"},
        "authoritative": {"const": false},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/resourceDescriptor"}}
      }
    }
  }
}
