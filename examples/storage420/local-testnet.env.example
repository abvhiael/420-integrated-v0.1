# 420Storage local/testnet example
# Copy this file outside source control before adding any private credentials.

420_STORAGE_URL=http://127.0.0.1:4209

# Canonical-safe object identity inputs. Replace with values resolved from your
# local/testnet canonical reader or fixture; do not derive these from S3 ETags.
OBJECT_ID=example-object-id
MANIFEST_ID=example-manifest-id
SHARD_INDEX=0
SHARD_ROOT=example-shard-root
SIZE_BYTES=1
COMMITMENT_ID=example-commitment-id

# Private-read values are intentionally blank. Inject at runtime from your shell
# or secret manager. Never commit real subjects/session identifiers/tokens.
420_SUBJECT=
420_SESSION_ID=

# Upload preparation dependencies. These are identifiers, not secrets, but they
# must correspond to valid canonical/testnet state before upload preparation.
AGREEMENT_ID=example-agreement-id
CAPACITY_RESERVATION_ID=example-capacity-reservation-id
IDEMPOTENCY_KEY=replace-per-mutation

# S3 compatibility namespace example. Bucket/key resolve through the adapter to
# the explicit 420 object identity above; they are not canonical identity alone.
S3_BUCKET=example-bucket
S3_KEY=example/key.bin
