{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "420-exchange-order-publication-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","domain","order","signature"],
  "properties": {
    "schema": {"const": "420-exchange-order-publication-v1"},
    "domain": {
      "type":"object","additionalProperties":false,
      "required":["name","version","chainId","verifyingContract"],
      "properties":{
        "name":{"const":"420Exchange Limit Orders"},"version":{"const":"1"},
        "chainId":{"type":["string","integer"]},"verifyingContract":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"}
      }
    },
    "order": {
      "type":"object","additionalProperties":false,
      "required":["maker","sellToken","buyToken","sellAmountRaw","minBuyAmountRaw","recipient","marketId","nonce","expiry","allowPartial"],
      "properties":{
        "maker":{"type":"string"},"sellToken":{"type":"string"},"buyToken":{"type":"string"},
        "sellAmountRaw":{"type":"string","pattern":"^[1-9][0-9]*$"},"minBuyAmountRaw":{"type":"string","pattern":"^[1-9][0-9]*$"},
        "recipient":{"type":"string"},"marketId":{"type":"string"},"nonce":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
        "expiry":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},"allowPartial":{"type":"boolean"}
      }
    },
    "signature":{"type":"string","pattern":"^0x[0-9a-fA-F]{130}$"},
    "marketId":{"type":"string"}
  }
}
