{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"420-exchange-order-withdrawal-v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","maker","nonce","requestId"],
  "properties":{
    "schema":{"const":"420-exchange-order-withdrawal-v1"},
    "maker":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},
    "nonce":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
    "requestId":{"type":"string","minLength":8,"maxLength":128}
  }
}
