{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "420-exchange-swap-quote-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","account","tokenIn","tokenOut","recipient","amountInRaw","minimumOutputRaw"],
  "properties": {
    "schema": {"const":"420-exchange-swap-quote-request-v1"},
    "account": {"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},
    "tokenIn": {"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},
    "tokenOut": {"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},
    "recipient": {"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},
    "amountInRaw": {"type":"string","pattern":"^[1-9][0-9]*$"},
    "minimumOutputRaw": {"type":"string","pattern":"^[1-9][0-9]*$"}
  }
}
