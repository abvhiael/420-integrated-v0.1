    "demo": {"const":false},
    "fixture": {"const":false},
    "quoteId": {"type":"string","pattern":"^0x[0-9a-f]{64}$"},
    "chainId": {"type":"string","pattern":"^0x[0-9a-f]+$"}
  }
}
