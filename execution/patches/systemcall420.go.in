package systemcall420

import (
    "bytes"
    "crypto/sha256"
    "encoding/binary"
 "encoding/json"
    "errors"
    "fmt"
    "math/big"
    "sync"

    "github.com/ethereum/go-ethereum/accounts/abi"
    "github.com/ethereum/go-ethereum/common"
    "github.com/ethereum/go-ethereum/common/hexutil"
    "github.com/ethereum/go-ethereum/crypto"
 "github.com/ethereum/go-ethereum/core/types"
 "github.com/ethereum/go-ethereum/ethdb"
    "github.com/holiman/uint256"
)

const (
    BatchDomain      = "420/CONSENSUS_SYSTEM_CALL_BATCH/V1"
    MaxCallsPerBatch = 64
    MaxPayloadBytes  = 256 * 1024
    MaxActionBytes   = 96
    StagingRetention = 4096
)

var GatewayAddress = common.HexToAddress("0x000000000000000000000000000000000000043c")

var RewardControllerAddress = common.HexToAddress("0x0000000000000000000000000000000000000420")

const RewardAction420 = "420/SYSCALL/REWARD/V1"

// A canonical system-call batch fixes an execution reward, but a value in the
// batch is NOT permission to mint. Independently derive the active-committee
// reward schedule before crediting native $420 to RewardController.
var (
    rewardSelector420 = [4]byte{0xac, 0x11, 0xb5, 0xe1}
    issuanceInitial420 = big.NewInt(4_200_000_000_000_000_000)
    issuanceFloor420 = big.NewInt(420_000_000_000_000_000)
    ErrRewardBacking = errors.New("420 native reward amount mismatches canonical issuance")
)

func rewardWord420(p []byte,i int) *big.Int {
    k:=4+i*32
    return new(big.Int).SetBytes(p[k:k+32])
}
func scheduledGross420(block uint64) *big.Int {
    era:=block/420_000
    if era>=340 {return new(big.Int).Set(issuanceFloor420)}
    if era==0 {return new(big.Int).Set(issuanceInitial420)}
    n:=new(big.Int).Exp(big.NewInt(995_800),new(big.Int).SetUint64(era),nil)
    d:=new(big.Int).Exp(big.NewInt(1_000_000),new(big.Int).SetUint64(era),nil)
    gross:=new(big.Int).Mul(new(big.Int).Set(issuanceInitial420),n)
    gross.Div(gross,d)
    if gross.Cmp(issuanceFloor420)<0 {return new(big.Int).Set(issuanceFloor420)}
    return gross
}

// RewardBackingAmount validates exact ABI encoding and the frozen per-block
// issuance schedule. Only the ACTUALLY earned validator rewards plus Attention
// and Development are credited; missing committee reward shares are not minted.
func RewardBackingAmount(c Call) (*uint256.Int,bool,error) {
    if c.Action!=RewardAction420 {return nil,false,nil}
    p:=[]byte(c.Payload)
    if c.Target!=RewardControllerAddress || len(p)<4+8*32 ||
       !bytes.Equal(p[:4],rewardSelector420[:]) {return nil,true,ErrRewardBacking}
    n:=rewardWord420(p,7)
    if !n.IsUint64() || n.Uint64()>29 {return nil,true,ErrRewardBacking}
    count:=int(n.Uint64())
    if len(p)!=4+(8+count)*32 ||
       rewardWord420(p,0).Cmp(new(big.Int).SetUint64(uint64(c.ExecutionBlock)))!=0 ||
       rewardWord420(p,2).Cmp(big.NewInt(7*32))!=0 ||
       rewardWord420(p,1).Sign()==0 || rewardWord420(p,1).BitLen()>160 ||
       !bytes.Equal(p[4+32:4+32+12],make([]byte,12)) {return nil,true,ErrRewardBacking}
    proposer:=string(p[4+32+12:4+64])
    seen:=map[string]bool{proposer:true}
    for i:=0;i<count;i++ {
        word:=p[4+(8+i)*32:4+(9+i)*32]
        addr:=string(word[12:])
        if !bytes.Equal(word[:12],make([]byte,12)) ||
           addr==string(make([]byte,20)) || seen[addr] {return nil,true,ErrRewardBacking}
        seen[addr]=true
    }
    proposerAmount:=rewardWord420(p,3)
    perParticipant:=rewardWord420(p,4)
    attentionAmount:=rewardWord420(p,5)
    developmentAmount:=rewardWord420(p,6)
    gross:=scheduledGross420(uint64(c.ExecutionBlock))
    valid:=false
    for active:=uint64(15);active<=30;active++ {
        if count>int(active)-1 {continue}
        scale:=uint64(283_446_712_018)+
            (uint64(500_000_000_000)-283_446_712_018)*(active-15)/15
        security:=new(big.Int).Mul(new(big.Int).Set(gross),new(big.Int).SetUint64(scale))
        security.Div(security,big.NewInt(1_000_000_000_000))
        remainder:=new(big.Int).Sub(new(big.Int).Set(gross),security)
        attention:=new(big.Int).Div(new(big.Int).Set(remainder),big.NewInt(2))
        development:=new(big.Int).Sub(remainder,attention)
        prop:=new(big.Int).Div(new(big.Int).Set(security),big.NewInt(2))
        pool:=new(big.Int).Sub(security,prop)
        per:=pool.Div(pool,new(big.Int).SetUint64(active-1))
        if prop.Cmp(proposerAmount)==0 && per.Cmp(perParticipant)==0 &&
           attention.Cmp(attentionAmount)==0 &&
           development.Cmp(developmentAmount)==0 {valid=true;break}
    }
    if !valid {return nil,true,ErrRewardBacking}
    amount:=new(big.Int).Mul(new(big.Int).Set(perParticipant),new(big.Int).SetUint64(uint64(count)))
    amount.Add(amount,proposerAmount)
    amount.Add(amount,attentionAmount)
    amount.Add(amount,developmentAmount)
    if amount.Sign()==0 || amount.Cmp(gross)>0 || amount.BitLen()>256 {
        return nil,true,ErrRewardBacking
    }
    u,overflow:=uint256.FromBig(amount)
    if overflow {return nil,true,ErrRewardBacking}
    return u,true,nil
}


var (
    ErrRoot      = errors.New("420 system-call batch root mismatch")
    ErrSequence  = errors.New("420 system-call sequence invalid")
    ErrContext   = errors.New("420 system-call context mismatch")
    ErrSize      = errors.New("420 system-call batch exceeds protocol limits")
    ErrNotStaged = errors.New("420 system-call batch not staged")
    ErrDuplicate = errors.New("420 system-call batch already staged with different root")
)

type Call struct {
    Sequence       hexutil.Uint64 `json:"sequence"`
    ExecutionBlock hexutil.Uint64 `json:"executionBlock"`
    ParentHash     common.Hash    `json:"parentHash"`
    ChainID        hexutil.Uint64 `json:"chainId"`
    Action         string         `json:"action"`
    Target         common.Address `json:"target"`
    Payload        hexutil.Bytes  `json:"payload"`
}

type Batch struct {
    ExecutionBlock hexutil.Uint64 `json:"executionBlock"`
    ParentHash     common.Hash    `json:"parentHash"`
    ChainID        hexutil.Uint64 `json:"chainId"`
    BatchRoot      common.Hash    `json:"batchRoot"`
    Calls          []Call         `json:"calls"`
}

type Status struct {
    Status          string      `json:"status"`
    BatchRoot       common.Hash `json:"batchRoot"`
    ValidationError *string     `json:"validationError,omitempty"`
}

type key struct {
    Number uint64
    Parent common.Hash
}

var staged = struct {
    sync.RWMutex
    m map[key]Batch
}{m: make(map[key]Batch)}

func Stage(batch Batch) error {
    if err := Validate(batch); err != nil {
        return err
    }
    want := Root(batch)
    if batch.BatchRoot != want {
        return fmt.Errorf("%w: supplied=%s computed=%s", ErrRoot, batch.BatchRoot, want)
    }
    k := key{Number: uint64(batch.ExecutionBlock), Parent: batch.ParentHash}
    staged.Lock()
    defer staged.Unlock()
    if old, ok := staged.m[k]; ok && old.BatchRoot != batch.BatchRoot {
        return ErrDuplicate
    }
    current := uint64(batch.ExecutionBlock)
    for oldKey := range staged.m {
        if oldKey.Number < current && current-oldKey.Number > StagingRetention {
            delete(staged.m, oldKey)
        }
    }
    staged.m[k] = clone(batch)
    return nil
}

// Replace is called only by the authenticated, finality/context-checked API.
func Replace(batch Batch) error {
    if err := Validate(batch); err != nil { return err }
    if batch.BatchRoot != Root(batch) { return ErrRoot }
    staged.Lock()
    defer staged.Unlock()
    staged.m[key{Number:uint64(batch.ExecutionBlock),Parent:batch.ParentHash}] = clone(batch)
    return nil
}

func Get(number uint64, parent common.Hash) (Batch, bool) {
    staged.RLock()
    defer staged.RUnlock()
    b, ok := staged.m[key{Number: number, Parent: parent}]
    return clone(b), ok
}

func RootFor(number uint64, parent common.Hash) (common.Hash, bool) {
    b, ok := Get(number, parent)
    if !ok {
        return common.Hash{}, false
    }
    return b.BatchRoot, true
}

func Validate(batch Batch) error {
    if batch.ParentHash == (common.Hash{}) || uint64(batch.ChainID) == 0 {
        return ErrContext
    }
    if len(batch.Calls) > MaxCallsPerBatch {
        return ErrSize
    }
    var payloadBytes int
    var want uint64
    if len(batch.Calls) != 0 {
        want = uint64(batch.Calls[0].Sequence)
        if want == 0 {
            return ErrSequence
        }
    }
    for i := range batch.Calls {
        c := batch.Calls[i]
        if uint64(c.Sequence) != want {
            return ErrSequence
        }
        if c.ExecutionBlock != batch.ExecutionBlock || c.ParentHash != batch.ParentHash || c.ChainID != batch.ChainID {
            return ErrContext
        }
        if len(c.Action) == 0 || len(c.Action) > MaxActionBytes || len(c.Payload) < 4 {
            return ErrSize
        }
        payloadBytes += len(c.Payload)
        if payloadBytes > MaxPayloadBytes {
            return ErrSize
        }
        want++
    }
    return nil
}

func Root(batch Batch) common.Hash {
    h := sha256.New()
    writeBytes(h, []byte(BatchDomain))
    writeU64(h, uint64(batch.ChainID))
    writeU64(h, uint64(batch.ExecutionBlock))
    h.Write(batch.ParentHash[:])
    writeU64(h, uint64(len(batch.Calls)))
    for i := range batch.Calls {
        writeCall(h, batch.Calls[i])
    }
    return common.BytesToHash(h.Sum(nil))
}

func writeCall(w interface{ Write([]byte) (int, error) }, c Call) {
    writeU64(w, uint64(c.Sequence))
    writeU64(w, uint64(c.ExecutionBlock))
    w.Write(c.ParentHash[:])
    writeU64(w, uint64(c.ChainID))
    writeBytes(w, []byte(c.Action))
    w.Write(c.Target[:])
    writeBytes(w, c.Payload)
}

func writeBytes(w interface{ Write([]byte) (int, error) }, b []byte) {
    writeU64(w, uint64(len(b)))
    w.Write(b)
}

func writeU64(w interface{ Write([]byte) (int, error) }, v uint64) {
    var b [8]byte
    binary.BigEndian.PutUint64(b[:], v)
    w.Write(b[:])
}

func clone(b Batch) Batch {
    out := b
    out.Calls = make([]Call, len(b.Calls))
    copy(out.Calls, b.Calls)
    for i := range out.Calls {
        out.Calls[i].Payload = bytes.Clone(b.Calls[i].Payload)
    }
    return out
}

var gatewayABI = mustABI(`[{"type":"function","name":"execute","inputs":[{"name":"sequence","type":"uint64"},{"name":"executionBlock","type":"uint64"},{"name":"parentHash","type":"bytes32"},{"name":"chainId","type":"uint256"},{"name":"action","type":"bytes32"},{"name":"target","type":"address"},{"name":"payload","type":"bytes"}],"outputs":[{"name":"callHash","type":"bytes32"}]}]`)

func mustABI(s string) abi.ABI {
    a, err := abi.JSON(bytes.NewBufferString(s))
    if err != nil {
        panic(err)
    }
    return a
}

func GatewayInput(c Call) ([]byte, error) {
    action := crypto.Keccak256Hash([]byte(c.Action))
    return gatewayABI.Pack("execute", uint64(c.Sequence), uint64(c.ExecutionBlock), c.ParentHash, new(big.Int).SetUint64(uint64(c.ChainID)), action, c.Target, []byte(c.Payload))
}

// Native logs are an observational archive, not synthetic transaction receipts.
// Persist them atomically with accepted block data; never from payload building.
func nativeLogKey(hash common.Hash) []byte { return append([]byte("420-native-logs-v1:"),hash[:]...) }
func WriteNativeLogs(db ethdb.KeyValueWriter,hash common.Hash,logs []*types.Log)error{
 if logs==nil{logs=[]*types.Log{}}
 for _,entry:=range logs { if entry==nil{return fmt.Errorf("nil native log")};if entry.Topics==nil{entry.Topics=[]common.Hash{}} }
 raw,err:=json.Marshal(logs);if err!=nil{return err}
 sum:=sha256.Sum256(raw);return db.Put(nativeLogKey(hash),append(sum[:],raw...))
}
func ReadNativeLogs(db ethdb.KeyValueReader,hash common.Hash)([]*types.Log,error){
 raw,err:=db.Get(nativeLogKey(hash));if err!=nil{return nil,fmt.Errorf("native log archive unavailable: %w",err)}
 if len(raw)<34{return nil,fmt.Errorf("corrupt native log archive")};sum:=sha256.Sum256(raw[32:]);if !bytes.Equal(sum[:],raw[:32]){return nil,fmt.Errorf("native log archive checksum mismatch")}
 var logs []*types.Log;if err=json.Unmarshal(raw[32:],&logs);err!=nil || logs==nil{return nil,fmt.Errorf("invalid native log archive")}
 for i,log:=range logs{if log==nil || log.BlockHash!=hash || log.TxHash!=(common.Hash{}) || log.Removed || (i>0 && log.Index<=logs[i-1].Index){return nil,fmt.Errorf("native log provenance mismatch")}}
 return logs,nil
}
