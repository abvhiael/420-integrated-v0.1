package systemcall420

import (
    "testing"
    "math/big"
 "github.com/ethereum/go-ethereum/core/rawdb"
 "github.com/ethereum/go-ethereum/core/types"

    "github.com/ethereum/go-ethereum/common"
    "github.com/ethereum/go-ethereum/common/hexutil"
)

func testBatch() Batch {
    parent := common.HexToHash("0x4201")
    call := Call{
        Sequence:       hexutil.Uint64(1),
        ExecutionBlock: hexutil.Uint64(4200),
        ParentHash:     parent,
        ChainID:        hexutil.Uint64(420),
        Action:         "420/SYSCALL/ROTATION_SNAPSHOT/V1",
        Target:         common.HexToAddress("0x0000000000000000000000000000000000000423"),
        Payload:        hexutil.Bytes{0x12, 0x34, 0x56, 0x78},
    }
    b := Batch{
        ExecutionBlock: hexutil.Uint64(4200),
        ParentHash:     parent,
        ChainID:        hexutil.Uint64(420),
        Calls:          []Call{call},
    }
    b.BatchRoot = Root(b)
    return b
}

func TestBatchRootChangesWithOrder(t *testing.T) {
    b := testBatch()
    second := b.Calls[0]
    second.Sequence = hexutil.Uint64(2)
    second.Action = "420/SYSCALL/REWARD/V1"
    second.Target = common.HexToAddress("0x0000000000000000000000000000000000000420")
    b.Calls = append(b.Calls, second)
    forward := Root(b)
    b.Calls[0], b.Calls[1] = b.Calls[1], b.Calls[0]
    if Root(b) == forward {
        t.Fatal("batch root must commit call ordering")
    }
}

func TestValidateRejectsSequenceGap(t *testing.T) {
    b := testBatch()
    second := b.Calls[0]
    second.Sequence = hexutil.Uint64(3)
    b.Calls = append(b.Calls, second)
    if err := Validate(b); err != ErrSequence {
        t.Fatalf("got %v want ErrSequence", err)
    }
}

func TestValidateRejectsOversizedBatch(t *testing.T) {
    b := testBatch()
    b.Calls = nil
    for i := 0; i < MaxCallsPerBatch+1; i++ {
        c := testBatch().Calls[0]
        c.Sequence = hexutil.Uint64(i + 1)
        b.Calls = append(b.Calls, c)
    }
    if err := Validate(b); err != ErrSize {
        t.Fatalf("got %v want ErrSize", err)
    }
}

func TestValidateRejectsPayloadBudgetOverflow(t *testing.T) {
    b := testBatch()
    b.Calls[0].Payload = make(hexutil.Bytes, MaxPayloadBytes+1)
    if err := Validate(b); err != ErrSize {
        t.Fatalf("got %v want ErrSize", err)
    }
}

func TestStageRejectsWrongRoot(t *testing.T) {
    b := testBatch()
    b.BatchRoot = common.HexToHash("0xdeadbeef")
    if err := Stage(b); err == nil {
        t.Fatal("wrong batch root accepted")
    }
}

func TestStageRejectsConflictingBatchForSameBlockParent(t *testing.T) {
    b := testBatch()
    if err := Stage(b); err != nil {
        t.Fatal(err)
    }
    conflicting := b
    conflicting.Calls = append([]Call(nil), b.Calls...)
    conflicting.Calls[0].Payload = hexutil.Bytes{0xde, 0xad, 0xbe, 0xef}
    conflicting.BatchRoot = Root(conflicting)
    if err := Stage(conflicting); err != ErrDuplicate {
        t.Fatalf("got %v want ErrDuplicate", err)
    }
}

func TestGatewayInputUsesExecuteSelector(t *testing.T) {
    b := testBatch()
    input, err := GatewayInput(b.Calls[0])
    if err != nil {
        t.Fatal(err)
    }
    want := gatewayABI.Methods["execute"].ID
    if len(input) < 4 || string(input[:4]) != string(want) {
        t.Fatalf("gateway selector mismatch: got %x want %x", input[:4], want)
    }
}

func TestExplicitReplacementPreservesValidationAndCopies(t *testing.T) {
    b := testBatch()
    b.ExecutionBlock = 4201
    b.Calls[0].ExecutionBlock = b.ExecutionBlock
    b.BatchRoot = Root(b)
    if err := Stage(b); err != nil { t.Fatal(err) }
    replacement := clone(b)
    replacement.Calls[0].Payload[0] ^= 1
    replacement.BatchRoot = Root(replacement)
    if err := Stage(replacement); err != ErrDuplicate { t.Fatalf("implicit replacement: %v", err) }
    if err := Replace(replacement); err != nil { t.Fatal(err) }
    replacement.Calls[0].Payload[0] ^= 1
    got, ok := Get(uint64(b.ExecutionBlock), b.ParentHash)
    if !ok || got.BatchRoot == b.BatchRoot || Root(got) != got.BatchRoot { t.Fatal("replacement lost root binding or aliased caller") }
    malformed := clone(got)
    malformed.Calls[0].Sequence = 0
    if err := Replace(malformed); err == nil { t.Fatal("replacement bypassed validation") }
    after, _ := Get(uint64(b.ExecutionBlock), b.ParentHash)
    if after.BatchRoot != got.BatchRoot { t.Fatal("invalid replacement changed staging") }
}

func TestNativeLogArchiveIntegrity(t *testing.T) {
 db:=rawdb.NewMemoryDatabase();defer db.Close();hash:=common.HexToHash("0x420")
 if _,err:=ReadNativeLogs(db,hash);err==nil{t.Fatal("missing archive accepted")}
 logs:=[]*types.Log{{Address:common.HexToAddress("0x43c"),BlockHash:hash,BlockNumber:1,Index:2,Data:[]byte{1}}}
 if err:=WriteNativeLogs(db,hash,logs);err!=nil{t.Fatal(err)}
 got,err:=ReadNativeLogs(db,hash);if err!=nil||len(got)!=1||got[0].Index!=2{t.Fatal(got,err)}
 batch:=db.NewBatch();other:=common.HexToHash("0x421");if err=WriteNativeLogs(batch,other,nil);err!=nil{t.Fatal(err)}
 if _,err=ReadNativeLogs(db,other);err==nil{t.Fatal("uncommitted archive visible")};if err=batch.Write();err!=nil{t.Fatal(err)}
 if got,err=ReadNativeLogs(db,other);err!=nil||len(got)!=0{t.Fatal("accepted empty archive",err)}
 raw,_:=db.Get(nativeLogKey(hash));raw[len(raw)-1]^=1;db.Put(nativeLogKey(hash),raw)
 if _,err=ReadNativeLogs(db,hash);err==nil{t.Fatal("corrupt archive accepted")}
 logs[0].BlockHash=other;WriteNativeLogs(db,hash,logs);if _,err=ReadNativeLogs(db,hash);err==nil{t.Fatal("orphan provenance accepted")}
}

func rewardFixture420(t *testing.T) (Call,*big.Int) {
    t.Helper()
    b:=testBatch()
    c:=b.Calls[0]
    c.Action=RewardAction420
    c.Target=RewardControllerAddress
    // For a 15-seat active committee, proposer receives half of the security
    // pool; only two participating validators earn their equal pool share.
    gross:=scheduledGross420(uint64(c.ExecutionBlock))
    security:=new(big.Int).Mul(new(big.Int).Set(gross),big.NewInt(283_446_712_018))
    security.Div(security,big.NewInt(1_000_000_000_000))
    remainder:=new(big.Int).Sub(gross,security)
    attention:=new(big.Int).Div(new(big.Int).Set(remainder),big.NewInt(2))
    development:=new(big.Int).Sub(remainder,attention)
    proposer:=new(big.Int).Div(new(big.Int).Set(security),big.NewInt(2))
    pool:=new(big.Int).Sub(security,proposer)
    per:=new(big.Int).Div(pool,big.NewInt(14))
    toWord:=func(n *big.Int) []byte {
        out:=make([]byte,32)
        b:=n.Bytes()
        copy(out[32-len(b):],b)
        return out
    }
    u:=func(n uint64) []byte {return toWord(new(big.Int).SetUint64(n))}
    raw:=[]byte{0xac,0x11,0xb5,0xe1}
    raw=append(raw,u(uint64(c.ExecutionBlock))...)
    raw=append(raw,u(0x1234)...) // canonical proposer padded to address
    raw=append(raw,u(7*32)...)
    for _,n:=range []*big.Int{proposer,per,attention,development} {
        raw=append(raw,toWord(n)...)
    }
    raw=append(raw,u(2)...)
    raw=append(raw,u(0x1235)...)
    raw=append(raw,u(0x1236)...)
    c.Payload=hexutil.Bytes(raw)
    earned:=new(big.Int).Mul(new(big.Int).Set(per),big.NewInt(2))
    earned.Add(earned,proposer)
    earned.Add(earned,attention)
    earned.Add(earned,development)
    return c,earned
}

func TestNativeRewardBackingExactScheduleAndNoUnauthorizedIssuance420(t *testing.T) {
    c,want:=rewardFixture420(t)
    got,qualifies,err:=RewardBackingAmount(c)
    if !qualifies||err!=nil||got.ToBig().Cmp(want)!=0 {
        t.Fatalf("realized issuance mismatch: valid=%v reward=%v err=%v want=%v",qualifies,got,err,want)
    }
    negative:=func(name string,change func(*Call)){
        t.Run(name,func(t *testing.T){
            bad:=c
            bad.Payload=append(hexutil.Bytes(nil),c.Payload...)
            change(&bad)
            if amount,qualified,err:=RewardBackingAmount(bad);!qualified||err==nil||amount!=nil {
                t.Fatalf("forged native backing accepted: qualified=%v amount=%v err=%v",qualified,amount,err)
            }
        })
    }
    negative("reward-target",func(x *Call){x.Target=GatewayAddress})
    negative("reward-selector",func(x *Call){x.Payload[0]^=0x01})
    negative("execution-block",func(x *Call){x.Payload[4+31]^=0x01})
    negative("gross-plus-1-wei",func(x *Call){x.Payload[4+3*32+31]^=0x01})
    negative("participant-duplicate",func(x *Call){copy(x.Payload[len(x.Payload)-32:],x.Payload[len(x.Payload)-64:len(x.Payload)-32])})
    negative("noncanonical-participant",func(x *Call){x.Payload[4+8*32]=0x01})
    negative("truncated-payload",func(x *Call){x.Payload=x.Payload[:len(x.Payload)-1]})
    negative("extra-participant",func(x *Call){x.Payload=append(x.Payload,make([]byte,32)...);x.Payload[4+7*32+31]=3})
    negative("attention-double-mint",func(x *Call){x.Payload[4+5*32+31]^=0x01})
    negative("noncanonical-proposer",func(x *Call){x.Payload[4+32]=0x01})
    negative("wrong-dynamic-offset",func(x *Call){x.Payload[4+2*32+31]=0x01})
    other:=c
    other.Action="420/SYSCALL/VALIDATOR_STATE/V1"
    if amount,isReward,err:=RewardBackingAmount(other);amount!=nil||isReward||err!=nil {
        t.Fatalf("non-reward call minted funds: %v %v %v",amount,isReward,err)
    }
}

