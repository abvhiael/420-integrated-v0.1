  "authorityLedger": [
    {
      "domain": "Wallet/SmartAccount authorization",
      "owner": "Wallet / Smart Accounts",
      "hzRole": "consume qualified actor/session/capability references only",
      "derived": false
    },
    {
      "domain": "Identity/eligibility credentials",
      "owner": "420Identity or explicitly approved verifier source",
      "hzRole": "consume minimum-disclosure profile/eligibility results only",
      "derived": false
    },
    {
      "domain": "AI generation execution",
      "owner": "420AI + Compute Market",
      "hzRole": "orchestrate/request/observe jobs; never become provider or settlement authority",
      "derived": false
    },
    {
      "domain": "Creative publication identity",
      "owner": "420 Creative Protocol",
      "hzRole": "reference native Creator/Work/Recording IDs and request registration/publication",
      "derived": false
    },
    {
      "domain": "Rights/licenses/provenance authority",
      "owner": "420 Rights / Creative rights registries",
      "hzRole": "validate and reference rights/consent; moderation cannot rewrite",
      "derived": false
    },
    {
      "domain": "Private Generate project/workspace state",
      "owner": "420Hz application product domain",
      "hzRole": "canonical for project/draft/selection/workflow state only",
      "derived": false
    },
    {
      "domain": "Artifact storage availability/integrity",
      "owner": "Resource Protocol / qualified storage provider",
      "hzRole": "retain StorageObjectRef/manifest and privacy/retention policy",
      "derived": false
    },
    {
      "domain": "Generation funding/settlement",
      "owner": "420AI/Compute Market/Vault and canonical payment rails",
      "hzRole": "display/reconcile; never fabricate provider entitlement/refund/payment",
      "derived": false
    },
    {
      "domain": "Community source relations",
      "owner": "420Hz Community product domain",
      "hzRole": "canonical for ArtistFollow/RecordingFavorite/Playlist/PlaylistItem",
      "derived": false
    },
    {
      "domain": "Charts",
      "owner": "420Hz Charts policy over eligible source data",
      "hzRole": "publish deterministic rebuildable ChartSnapshot",
      "derived": true
    },
    {
      "domain": "Awards product state",
      "owner": "420Hz Awards product domain",
      "hzRole": "canonical for Program/Season/Category/Nomination/Ballot/Vote/Result/Badge",
      "derived": false
    },
    {
      "domain": "Moderation application enforcement",
      "owner": "420Hz moderation product domain",
      "hzRole": "reports/hide/lock/suspend/block/mute/appeal/restore within application scope",
      "derived": false
    },
    {
      "domain": "Arbitration",
      "owner": "420Arbitration when explicitly adopted",
      "hzRole": "consume bounded finalized ruling references through allowlisted remedies only",
      "derived": false
    },
    {
      "domain": "Indexer/Search",
      "owner": "420Indexer / 420Search",
      "hzRole": "read/rebuild public projections only",
      "derived": true
    },
    {
      "domain": "Analytics",
      "owner": "420Analytics",
      "hzRole": "privacy-safe aggregate derived metrics only",
      "derived": true
    },
    {
      "domain": "Notifications",
      "owner": "420Notifications",
      "hzRole": "delivery only; no source mutation authority",
      "derived": true
    },
    {
      "domain": "Governance",
      "owner": "420Governance / Civic",
      "hzRole": "no Awards/Community/Charts mutation authority",
      "derived": false
    }
  ],
  "authoritativeVsDerived": {
    "authoritative": [
      "Wallet/SmartAccount authorization",
      "420Identity credential/eligibility source state",
      "420AI/Compute Market job/match/verification/settlement state",
