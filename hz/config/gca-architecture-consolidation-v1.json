  "architectureSeparations": [
    "AI transformation permission is distinct from training permission",
    "Generate success is distinct from Creative registration/publication",
    "raw play is distinct from qualified play",
    "Community relation is distinct from Chart credit",
    "Chart rank is distinct from Awards eligibility/result",
    "AwardVote is distinct from Chart, Community and Civic/Governance voting",
    "moderation application enforcement is distinct from Creative/Rights/Identity/Wallet/payment/governance authority",
    "Arbitration ruling is a bounded input and not ambient remedy authority",
    "Notification/Search/Indexer/Analytics state is derived/presentation and not canonical source authority",
    "partial output is distinct from verified success/publication/settlement",
    "payer refundable/claimable/paid and provider earned/claimable/paid are distinct economic states"
  ],
  "crossCuttingRules": {
    "authorization": "Authority-bearing mutations require qualified Wallet/session actor plus domain/resource/idempotency context.",
    "privacy": "Private generation inputs/drafts/stems/reference audio and secret material remain non-public unless an explicit later publication rule says otherwise.",
    "storage": "Integrity commitments and deletion/tombstone state survive restart/rebuild; storage references do not imply universal physical deletion authority.",
    "economics": "No hidden 420Hz surcharge; retries must not duplicate charge or provider entitlement.",
    "charts": "Charts are deterministic, versioned and rebuildable derived projections.",
    "awards": "Awards policy/ballot/result history is versioned/frozen and finalization is deterministic and single-use.",
    "moderation": "Moderation is application scoped, append-only/auditable and cannot rewrite external protocol truth.",
    "recovery": "Canonical/source authority is reconciled before retries that could create spend, entitlement, publication, vote, moderation or remedy effects."
  },
