  "workPackage": "HZ-GCA-1.2",
  "title": "Define canonical object model",
  "baseMainSha": "537525ebc636eabc76ff261f5b5ff5d236869b32",
  "level": 1,
  "milestoneRequired": false,
  "identityRules": {
    "hzOwnedIdEncoding": "opaque bytes32 logical IDs; storage/ABI encoding remains implementation-specific unless a later step freezes it",
    "externalIds": "preserve the owning protocol's native canonical ID exactly; never re-hash or remap it into a second canonical identity",
    "privateObjects": "private/draft identifiers must not encode plaintext prompts, lyrics, wallet secrets or provider credentials",
    "uniqueness": "one object type + one ID identifies one logical object; IDs are never silently recycled after deletion/tombstone",
    "versioning": "material semantic revisions create a new version or explicit revision edge rather than rewriting immutable history"
  },
  "objectClasses": [
    "HZ_PRIVATE_APPLICATION",
    "HZ_PUBLIC_APPLICATION",
    "HZ_AWARD_CANONICAL_PRODUCT_DOMAIN",
