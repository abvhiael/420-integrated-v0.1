{
  "name": "@420integrated/liftd-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --offline",
    "check": "tsc --noEmit && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "native:android": "expo run:android --variant debug",
    "native:ios": "expo run:ios --configuration Debug",
    "prebuild:android": "expo prebuild --platform android --non-interactive --no-install",
    "prebuild:ios": "expo prebuild --platform ios --non-interactive --no-install"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "expo-status-bar": "~3.0.8",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
