{
  "schema": "420-testnet-explorer-readiness-v3",
  "genesis_profile": "contracts/config/420explorer-genesis.json",
  "backend": {
    "url": "REPLACE",
    "status": "INDEXER_CONSUMER_IMPLEMENTED_PENDING_DEPLOYMENT",
    "data_source": "420Indexer /v1",
    "independent_chain_ingestion": false,
    "required_checks": [
      "consumes indexed blocks from 420Indexer",
      "consumes transactions from 420Indexer",
      "consumes receipts/logs from 420Indexer",
      "consumes head safe and finalized health from 420Indexer",
      "uses 420Indexer deterministic fixed-snapshot pagination",
      "does not implement an independent JSON-RPC block crawler",
      "does not maintain an independent checkpoint or reorg engine",
      "does not maintain an independent protocol decoder registry",
      "fails closed if an indexer response claims canonical authority",
      "surfaces stale/degraded/wrong-chain indexer state"
    ],
    "qualification_evidence": {
      "go_client": "explorer/indexerclient/client.go",
      "consumer_boundary_tests": "explorer/indexerclient/client_test.go",
      "shared_verifier": "scripts/verify-explorer-indexer-consumer.py"
    }
  },
  "protocol_discovery": {
    "registry": "420Indexer Registry-backed service/version projection",
    "required_checks": [
      "resolves active registered services through 420Indexer",
      "preserves historical service/version decoding through 420Indexer",
      "shows runtime code hash when indexed/available",
      "shows manifest/interface commitments when registered",
      "fails closed on unavailable or unknown service/version resolution"
    ]
  },
  "frontend": {
    "url": "REPLACE",
    "status": "PENDING",
    "required_views": [
      "block",
      "transaction",
      "receipt/logs",
      "address",
      "contract",
      "token/asset activity",
      "validator",
      "epoch/rotation",
      "protocol service/version",
      "network status"
    ],
    "required_labels": [
      "chain id",
      "head",
      "safe",
      "finalized",
      "indexed height",
      "finalized height"
    ]
  },
  "consensus_fields": [
    "slot",
    "epoch",
    "rotation",
    "head",
    "safe",
    "finalized",
    "proposer seat",
    "proposer rank",
    "QC signer count"
  ],
  "authority": {
    "canonical_state": false,
    "custody": false,
    "governance": false,
    "bridge": false,
    "validator": false,
    "smart_account_execution": false
  }
}
