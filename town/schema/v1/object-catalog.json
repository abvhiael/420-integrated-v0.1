{
  "schema": "420-town-object-catalog-v1",
  "namespace": "420Town",
  "version": "v1",
  "id_policy": "OPAQUE_STABLE_IDS",
  "timestamp_policy": "RFC3339_UTC",
  "required_metadata": [
    "id",
    "kind",
    "namespace",
    "version",
    "created_at",
    "updated_at",
    "visibility",
    "source"
  ],
  "visibility": [
    "PUBLIC",
    "UNLISTED",
    "FOLLOWERS",
    "COMMUNITY_ONLY",
    "PURCHASERS_OR_BACKERS",
    "PRIVATE",
    "ORGANIZATION_MEMBERS",
    "MODERATORS",
    "ADMINS"
  ],
  "authority_v1": {
    "contract": "TownAuthority420",
    "membership_states": [
      "NONE",
      "ACTIVE",
      "LEFT",
      "REMOVED"
    ],
    "subscription_states": [
      "NONE",
      "ACTIVE",
      "CANCELLED",
      "EXPIRED"
    ],
    "entitlement_states": [
      "NONE",
      "ACTIVE",
      "REVOKED",
      "EXPIRED"
    ],
    "roles": [
      "MEMBER",
      "MODERATOR",
      "ADMIN"
    ],
    "permissions": [
      "MANAGE_MEMBERS",
      "MANAGE_ROLES",
      "MANAGE_SUBSCRIPTIONS",
      "MANAGE_ENTITLEMENTS",
      "MANAGE_TREASURY"
    ],
    "treasury_mode": "REFERENCE_ONLY"
  },
  "content_v1": {
    "package": "town/content",
    "state_class": "REPLACEABLE_OFF_CHAIN_APPLICATION_STATE",
    "body_storage": "OFF_CHAIN_BY_DEFAULT",
    "content_digest": "SHA-256_LOWERCASE_HEX",
    "content_status": [
      "ACTIVE",
      "TOMBSTONED"
    ],
    "vote_target_kinds": [
      "POST",
      "COMMENT"
    ],
    "vote_values": [
      -1,
      1
    ],
    "idempotency_required": true,
    "historical_revisions": "APPEND_ONLY",
    "comments_inherit_root_visibility": true,
    "unknown_visibility": "DENY"
  },
  "objects": [
    {
      "kind": "Community",
      "fields": [
        "owner_identity_id",
        "title"
      ]
    },
    {
      "kind": "Membership",
      "fields": [
        "community_id",
        "identity_id",
        "state"
      ]
    },
    {
      "kind": "RoleBinding",
      "fields": [
        "community_id",
        "identity_id",
        "role_id"
      ]
    },
    {
      "kind": "PermissionGrant",
      "fields": [
        "community_id",
        "subject_id",
        "permission"
      ]
    },
    {
      "kind": "Subscription",
      "fields": [
        "community_id",
        "subscriber_id",
        "state"
      ]
    },
    {
      "kind": "Entitlement",
      "fields": [
        "community_id",
        "beneficiary_id",
        "entitlement_type",
        "state"
      ]
    },
    {
      "kind": "TreasuryRef",
      "fields": [
        "community_id",
        "authority_id"
      ]
    },
    {
      "kind": "Post",
      "fields": [
        "community_id",
        "author_id",
        "content_ref",
        "content_sha256",
        "status",
        "revision"
      ]
    },
    {
      "kind": "Thread",
      "fields": [
        "community_id",
        "root_post_id",
        "author_id",
        "status"
      ]
    },
    {
      "kind": "Comment",
      "fields": [
        "community_id",
        "thread_id",
        "parent_id",
        "author_id",
        "content_ref",
        "content_sha256",
        "status",
        "revision"
      ]
    },
    {
      "kind": "Vote",
      "fields": [
        "community_id",
        "target_kind",
        "target_id",
        "voter_id",
        "value",
        "active",
        "revision"
      ]
    },
    {
      "kind": "ModerationAction",
      "fields": [
        "case_id",
        "community_id",
        "target_kind",
        "target_id",
        "affected_id",
        "actor_id",
        "action",
        "reason",
        "parent_record_id",
        "previous_state",
        "result_state",
        "body_ref",
        "body_sha256",
        "version"
      ]
    }
  ],
  "boundary": {
    "authority_bearing_state": [
      "Community",
      "Membership",
      "RoleBinding",
      "PermissionGrant",
      "Subscription",
      "Entitlement",
      "TreasuryRef"
    ],
    "replaceable_application_state": [
      "Post",
      "Thread",
      "Comment",
      "Vote",
      "ModerationAction"
    ],
    "off_chain_body_defaults": [
      "Post.content_ref",
      "Comment.content_ref"
    ],
    "projection_authority": false
  },
  "moderation_v1": {
    "package": "town/moderation",
    "state_class": "REPLACEABLE_OFF_CHAIN_APPLICATION_STATE",
    "actions": [
      "REPORT",
      "HIDE",
      "BLOCK",
      "MUTE",
      "SUSPEND",
      "APPEAL",
      "MODERATOR_DECISION",
      "RESTORE",
      "LOCK"
    ],
    "states": [
      "OPEN",
      "HIDDEN",
      "LOCKED",
      "SUSPENDED",
      "APPEALED",
      "RESOLVED",
      "RESTORED"
    ],
    "target_kinds": [
      "POST",
      "COMMENT",
      "USER"
    ],
    "moderator_roles": [
      "MODERATOR",
      "ADMIN"
    ],
    "community_scoped": true,
    "block_mute_user_scoped": true,
    "append_only_case_log": true,
    "content_gate_required": true
  }
}
