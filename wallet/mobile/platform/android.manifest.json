{
  "platform": "android",
  "minimumApiLevel": 34,
  "capabilities": {
    "secureStorage": "keystore",
    "passkeys": true,
    "nonExportableSessionSigner": true,
    "nativeTransactionSubmit": true,
    "appLinks": true,
    "lifecycleResume": true,
    "lifecyclePause": true
  },
  "security": {
    "exportablePrivateKeys": false,
    "cleartextTraffic": false,
    "remoteSignerAuthority": false
  }
}
